{
  "name": "reksadana-id",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scrape": "node scripts/scrape-all.js",
    "scrape:bibit": "node scrapers/bibit.js",
    "scrape:kontan": "node scrapers/kontan.js",
    "scrape:kontan:full": "node scrapers/kontan.js --full",
    "scrape:makmur": "node scrapers/makmur.js",
    "scrape:bareksa": "node scrapers/bareksa.js",
    "scrape:bareksa:profiles": "node scrapers/bareksa.js --profiles",
    "scrape:bareksa:nav": "node scrapers/bareksa.js --nav",
    "scrape:bareksa:nav:all": "node scrapers/bareksa.js --nav-all",
    "scrape:benchmarks": "node scrapers/benchmarks.js",
    "scrape:macro": "node scrapers/macro.js",
    "scrape:ojk": "node scrapers/ojk.js",
    "sync:bareksa-nav": "node scripts/bareksa-nav-sync.js",
    "link": "node scripts/link-funds.js",
    "pretest": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --silent",
    "test": "node --test scrapers/*.test.js scripts/*.test.js src/*.test.js src/lib/*.test.js",
    "dev": "astro dev",
    "build": "astro build && node scripts/write-redirects.js && node scripts/check-dist.js && node scripts/check-funds.js",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@inlang/paraglide-js": "^2.26.0",
    "astro": "^7.3.8",
    "fflate": "^0.8.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
