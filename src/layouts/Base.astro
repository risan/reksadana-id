---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/newsreader';
import '@fontsource/spline-sans-mono/400.css';
import '../styles/global.css';
import { latestNavDate } from '../lib/data.js';
import { formatDate } from '../lib/format.js';

const {
  title,
  description = 'NAV history, returns, and fund size for every Indonesian mutual fund (reksa dana), from Bibit, Bareksa, Kontan, and Makmur. Free to download.',
  section,
} = Astro.props;

const NAV_LINKS = [
  ['funds', '/', 'Funds'],
  ['download', '/download/', 'Download'],
  ['api', '/api/', 'API'],
];

const dataDate = latestNavDate();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2315171c'/%3E%3Cpath d='M5 22l7-7 5 4 10-10' stroke='%23fafaf7' stroke-width='3' fill='none'/%3E%3C/svg%3E" />
    <title>{title === 'Reksadana ID' ? title : `${title} · Reksadana ID`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">Reksadana<span>ID</span></a>
        <nav class="site-nav" aria-label="Main">
          {NAV_LINKS.map(([key, href, label]) => (
            <a href={href} aria-current={section === key ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <span class="site-freshness" title="The newest NAV date in the data">Data to {formatDate(dataDate)}</span>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Data from Bibit, Bareksa, Kontan, and Makmur. Not affiliated with any of them. Not financial advice: check a fund's
          prospectus before you invest. Buy links include the site owner's referral codes.
        </p>
        <nav aria-label="Footer">
          <a href="/download/">Download</a>
          <a href="/api/">API</a>
          <a href="https://github.com/risan/reksadana-id">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
