---
import '../styles/global.css';

const { title, description = 'Browse and download Indonesian mutual fund (reksa dana) data from Bibit, Kontan, Bareksa, and Makmur.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-title" href="/">Reksadana ID</a>
        <nav class="site-nav">
          <a href="/">Funds</a>
          <a href="/download/">Download</a>
          <a href="/api/">API</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      Data from the public API behind Bibit, from Kontan's pusatdata pages, and from the public websites of Bareksa and Makmur. Not affiliated with Bibit, Kontan, Bareksa, or Makmur. Not financial advice. Some links include the site owner's referral codes.
    </footer>
  </body>
</html>
