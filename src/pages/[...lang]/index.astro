---
import '../../styles/explorer.css';
import Base from '../../layouts/Base.astro';
import { loadFundSummaries } from '../../lib/data.js';
import { COLUMNS, COLUMN_KEYS, COLUMN_PRESETS, DEFAULT_COLUMNS } from '../../lib/explorer-columns.js';
import { DENSITIES } from '../../lib/explorer-preferences.js';
import { renderRows, renderTypeCards } from '../../lib/explorer-render.js';
import { DEFAULT_STATE, PAGE_SIZES, escapeHtml, filterFunds, fundCountLabel, managerOptions, prepareFunds, sortFunds } from '../../lib/explorer.js';
import { formatCount, formatDate } from '../../lib/format.js';
import { localePaths, localizeHref } from '../../lib/i18n.js';
import { icon } from '../../lib/icons.js';
import * as m from '../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';
const data = loadFundSummaries();
const funds = prepareFunds(data);
const initial = sortFunds(filterFunds(funds, DEFAULT_STATE), DEFAULT_STATE.sort, DEFAULT_STATE.dir);
const inactiveCount = funds.filter((fund) => !fund.active).length;
const dividendFundCount = funds.filter((fund) => fund.total).length;
const managers = managerOptions(funds);
const pageCount = Math.ceil(initial.length / DEFAULT_STATE.size);

const STATS = [
  [formatCount(funds.length, locale), m.stat_funds()],
  [formatCount(funds.length - inactiveCount, locale), m.stat_active()],
  [formatDate(data.date, locale), m.stat_updated()],
  ['4', m.stat_sources()],
];

const QUICK_FILTERS = [
  { key: 'sharia', label: m.filter_sharia(), icon: 'moon-star' },
  { key: 'bibit', label: m.filter_bibit() },
  { key: 'makmur', label: m.filter_makmur() },
  { key: 'dividends', label: m.tag_pays_dividends(), icon: 'coins' },
  { key: 'inactive', label: m.filter_inactive({ count: formatCount(inactiveCount, locale) }), title: m.filter_inactive_title() },
];

// Each row of the filter panel: a label, and one or two limits named like the URL parameters.
const FILTER_SECTIONS = [
  {
    title: m.filters_group_returns(),
    rows: [
      { label: m.filter_r1y(), unit: '%', inputs: [['r1y_min', m.field_min()], ['r1y_max', m.field_max()]] },
      { label: m.filter_cagr3(), unit: '%', inputs: [['r3y_min', m.field_min()]] },
    ],
  },
  {
    title: m.filters_group_risk(),
    rows: [{ label: m.filter_dd1(), unit: '%', inputs: [['dd_max', m.field_no_worse()], ['dd_min', m.field_worse()]] }],
  },
  {
    title: m.filters_group_size(),
    rows: [
      { label: m.filter_aum(), unit: m.unit_billion(), inputs: [['aum_min', m.field_min()]] },
      { label: m.filter_er(), unit: m.unit_percent_year(), inputs: [['er_max', m.field_max()]] },
      { label: m.filter_minbuy(), unit: 'Rp', inputs: [['minbuy_max', m.field_max()]] },
    ],
  },
  {
    title: m.filters_group_history(),
    rows: [
      { label: m.filter_launched(), unit: '', inputs: [['since', m.field_since()], ['before', m.field_before()]] },
      { label: m.filter_history(), unit: m.unit_years(), inputs: [['years', m.field_min()]] },
    ],
  },
];

const SORT_OPTIONS = [{ key: 'name', label: m.col_fund() }, ...COLUMNS.filter((column) => column.sortable !== false).map((column) => ({ key: column.key, label: column.label() }))];

// A column that is not showing is hidden by the table's `data-show` list, so choosing columns needs no new rows.
const hideColumnsCss = `${COLUMN_KEYS.map((key) => `.funds-table:not([data-show~='${key}']) .col-${key}`).join(',')} { display: none; }`;

const sortIcons = `<span class="sort-up">${icon('arrow-up', { size: 14 })}</span><span class="sort-down">${icon('arrow-down', { size: 14 })}</span>`;
---

<Base title="Reksadana ID" section="funds">
  <style is:inline set:html={hideColumnsCss}></style>

  <section class="hero kawung-bg">
    <h1 class="page-title">{m.home_title()}</h1>
    <p class="lede">{m.home_lede()}</p>
    <form class="hero-search" role="search" onsubmit="return false" data-needs-js>
      <label class="search search-large">
        <span class="visually-hidden">{m.search_label()}</span>
        <Fragment set:html={icon('search', { size: 20 })} />
        <input id="q" name="q" type="search" placeholder={m.search_placeholder()} autocomplete="off" spellcheck="false" />
        <kbd aria-hidden="true">/</kbd>
        <button type="button" class="icon-btn search-clear" id="search-clear" aria-label={m.search_clear()} hidden><Fragment set:html={icon('x')} /></button>
      </label>
    </form>
    <dl class="hero-stats">
      {STATS.map(([value, label]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
    <a class="hero-link" href={localizeHref('/download/', locale)}><Fragment set:html={icon('download', { size: 16 })} />{m.home_lede_download()}</a>
  </section>

  <div class="type-cards" id="type-cards" role="group" aria-label={m.type_strip_label()} data-needs-js set:html={renderTypeCards(funds, DEFAULT_STATE, locale)} />

  <section class="explorer" id="explorer">
    <div class="toolbar" id="toolbar" data-needs-js>
      <div class="seg" role="group" aria-label={m.currency_label()}>
        <button type="button" data-currency="" aria-pressed="true">{m.currency_all()}</button>
        <button type="button" data-currency="IDR" aria-pressed="false">IDR</button>
        <button type="button" data-currency="USD" aria-pressed="false">USD</button>
      </div>
      <div class="toolbar-actions">
        <button type="button" class="btn" id="filters-open" aria-haspopup="dialog">
          <Fragment set:html={icon('sliders-horizontal')} />{m.filters_button()}<span class="badge" id="filters-badge" hidden></span>
        </button>
        <button type="button" class="btn btn-columns" id="columns-button" popovertarget="columns-menu">
          <Fragment set:html={icon('columns-3')} />{m.columns_button()}
        </button>
        <div class="menu-popover columns-menu" id="columns-menu" popover>
          <div class="menu-section">
            <p class="menu-title">{m.columns_presets()}</p>
            <div class="preset-list">
              {COLUMN_PRESETS.map((preset) => <button type="button" class="chip" data-preset={preset.key} aria-pressed="false">{preset.label()}</button>)}
            </div>
          </div>
          <div class="menu-section">
            <p class="menu-title">{m.columns_show()}</p>
            <div class="column-list">
              {COLUMNS.map((column) => (
                <label><input type="checkbox" data-column={column.key} /> {column.label()}</label>
              ))}
            </div>
          </div>
          <div class="menu-section">
            <p class="menu-title">{m.columns_density()}</p>
            <div class="seg" role="group" aria-label={m.columns_density()}>
              {DENSITIES.map((density) => <button type="button" data-density={density} aria-pressed="false">{density === 'compact' ? m.density_compact() : m.density_comfortable()}</button>)}
            </div>
          </div>
        </div>
        <button type="button" class="btn btn-csv" id="csv-button" title={m.csv_title()} disabled>
          <Fragment set:html={icon('download')} /><span>CSV</span>
        </button>
      </div>
      <span class="dividends-switch">
        <label class="switch">
          <input type="checkbox" id="include-dividends" role="switch" />
          {m.dividends_toggle()}
        </label>
        <button type="button" class="icon-btn info-btn" popovertarget="dividends-info" aria-label={m.dividends_info_label()}><Fragment set:html={icon('info', { size: 16 })} /></button>
        <div class="info-popover" id="dividends-info" popover>{m.dividends_toggle_help({ count: formatCount(dividendFundCount, locale) })}</div>
      </span>
    </div>

    <div class="quick-filters" role="group" aria-label={m.quick_filters_label()} data-needs-js>
      {QUICK_FILTERS.map((filter) => (
        <button type="button" class="chip" data-toggle={filter.key} aria-pressed="false" title={filter.title}>
          {filter.icon && <Fragment set:html={icon(filter.icon, { size: 16 })} />}
          {filter.label}
        </button>
      ))}
    </div>

    <div class="results-bar" data-needs-js>
      <div class="results-main">
        <span class="result-count" id="count" aria-live="polite">{fundCountLabel(initial.length, locale)}</span>
        <div class="filter-chips" id="filter-chips" aria-label={m.filter_chips_label()}></div>
        <button type="button" class="link-button" id="clear-all" hidden>{m.clear_all()}</button>
      </div>
      <div class="results-side">
        <div class="sort-picker">
          <label class="visually-hidden" for="sort-select">{m.sort_by()}</label>
          <select id="sort-select">
            {SORT_OPTIONS.map((option) => <option value={option.key} selected={option.key === DEFAULT_STATE.sort}>{option.label}</option>)}
          </select>
          <button type="button" class="icon-btn" id="sort-direction" aria-label={m.sort_direction()}>
            <span class="sort-up"><Fragment set:html={icon('arrow-up')} /></span><span class="sort-down"><Fragment set:html={icon('arrow-down')} /></span>
          </button>
        </div>
      </div>
    </div>

    <div class="table-frame table-scroll" id="table-frame">
      <table class="tbl funds-table" id="funds-table" data-show={DEFAULT_COLUMNS.join(' ')} data-density={DENSITIES[0]} aria-label={m.table_label()}>
        <thead>
          <tr>
            <th class="c-compare"><span class="visually-hidden">{m.compare_col_header()}</span></th>
            <th class="c-fund" aria-sort={DEFAULT_STATE.sort === 'name' ? 'descending' : undefined}>
              <button type="button" class="sort" data-sort="name">{m.col_fund()}<Fragment set:html={sortIcons} /></button>
            </th>
            {COLUMNS.map((column) => (
              <th class={`col-${column.key} ${column.numeric ? 'num' : ''}`} title={column.title?.()} aria-sort={column.key === DEFAULT_STATE.sort ? 'descending' : undefined}>
                {column.sortable === false ? column.label() : <button type="button" class="sort" data-sort={column.key}>{column.label()}<Fragment set:html={sortIcons} /></button>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody id="rows" set:html={renderRows(initial, DEFAULT_STATE, data.date, locale)} />
      </table>
    </div>

    <div class="empty-state kawung-bg" id="empty-state" hidden>
      <Fragment set:html={icon('search', { size: 28 })} />
      <p id="empty-text"></p>
      <button type="button" class="btn" id="empty-clear">{m.clear_all()}</button>
    </div>

    <nav class="pager" aria-label={m.pager_label()} data-needs-js>
      <span class="muted" id="page-label">{m.pager_range({ first: formatCount(Math.min(1, initial.length), locale), last: formatCount(Math.min(DEFAULT_STATE.size, initial.length), locale), total: formatCount(initial.length, locale) })}</span>
      <div class="pager-steps">
        <button class="btn" type="button" id="previous-page" disabled><span class="flip"><Fragment set:html={icon('chevron-right', { size: 16 })} /></span>{m.pager_previous()}</button>
        <span id="page-of">{m.pager_page({ page: 1, pages: formatCount(pageCount, locale) })}</span>
        <button class="btn" type="button" id="next-page" disabled={initial.length <= DEFAULT_STATE.size}>{m.pager_next()}<Fragment set:html={icon('chevron-right', { size: 16 })} /></button>
      </div>
      <label class="page-size">
        {m.page_size_label()}
        <select id="page-size">
          {PAGE_SIZES.map((size) => <option value={size} selected={size === DEFAULT_STATE.size}>{size}</option>)}
        </select>
      </label>
    </nav>
  </section>

  <div class="compare-bar" id="compare-bar" hidden>
    <a class="btn btn-primary" id="compare-link" href={localizeHref('/compare/', locale)}></a>
    <button class="btn" type="button" id="compare-clear">{m.compare_clear()}</button>
  </div>

  <details class="method card">
    <summary>{m.method_title()}</summary>
    <ul>
      <li set:html={m.method_nav()} />
      <li set:html={m.method_returns()} />
      <li set:html={m.method_fall()} />
      <li set:html={m.method_costs()} />
      <li set:html={m.method_median()} />
      <li set:html={m.method_aum()} />
      <li set:html={m.method_inactive()} />
      <li set:html={m.method_flag()} />
    </ul>
  </details>

  <dialog class="filters-dialog" id="filters-dialog" aria-labelledby="filters-title" data-needs-js>
    <form method="dialog" class="sheet">
      <header class="sheet-head">
        <h2 id="filters-title">{m.filters_button()}</h2>
        <button type="submit" class="icon-btn" aria-label={m.filters_close()}><Fragment set:html={icon('x')} /></button>
      </header>
      <div class="sheet-body">
        <fieldset class="filter-section">
          <legend>{m.filter_manager()}</legend>
          <input type="search" id="manager-search" placeholder={m.manager_search()} aria-label={m.manager_search()} autocomplete="off" />
          <ul class="manager-list" id="manager-list">
            {managers.map((manager) => (
              <li data-name={manager.name.toLowerCase()}>
                <label><input type="checkbox" name="manager" value={manager.name} /> <span>{manager.name}</span> <span class="muted">{manager.count}</span></label>
              </li>
            ))}
          </ul>
          <p class="muted small" id="manager-none" hidden>{m.manager_none()}</p>
        </fieldset>
        {FILTER_SECTIONS.map((section) => (
          <fieldset class="filter-section">
            <legend>{section.title}</legend>
            {section.rows.map((row) => (
              <div class="filter-row">
                <p class="filter-label">{row.label}{row.unit && <span class="muted"> ({row.unit})</span>}</p>
                <div class="filter-inputs">
                  {row.inputs.map(([name, hint]) => (
                    <label class="field">
                      <span class="field-hint">{hint}</span>
                      <input type="number" name={name} inputmode="decimal" step="any" />
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </fieldset>
        ))}
        <p class="muted small">{m.filters_note()}</p>
      </div>
      <footer class="sheet-foot">
        <button type="button" class="btn" id="filters-reset">{m.filters_reset()}</button>
        <button type="submit" class="btn btn-primary" id="filters-show">{m.filters_show({ funds: fundCountLabel(initial.length, locale) })}</button>
      </footer>
    </form>
  </dialog>

  <noscript><style>[data-needs-js] { display: none; }</style></noscript>
</Base>

<script is:inline>
  // Before the table paints, apply the columns and density this reader chose. The keys are the ones of explorer-preferences.js.
  try {
    const table = document.getElementById('funds-table');
    const columns = localStorage.getItem('explorer-columns');
    const density = localStorage.getItem('explorer-density');

    if (columns && /^[a-z0-9_ ]+$/.test(columns)) {
      table.dataset.show = columns;
    }

    if (density === 'compact') {
      table.dataset.density = density;
    }
  } catch {}
</script>

<script>
  import { buildCsv } from '../../lib/explorer-csv.js';
  import { COLUMN_PRESETS } from '../../lib/explorer-columns.js';
  import { readColumns, readDensity, writeColumns, writeDensity } from '../../lib/explorer-preferences.js';
  import { renderRows, renderSkeletonRows, renderTypeCards } from '../../lib/explorer-render.js';
  import { activeFilters, advancedFilterCount, clearedFilters, defaultDirection, escapeHtml, filterFunds, fundCountLabel, hasActiveFilters, parseState, prepareFunds, serializeState, sortFunds } from '../../lib/explorer.js';
  import { MAX_FUNDS, selectionQuery } from '../../lib/compare.js';
  import { readTray, toggleInTray, writeTray } from '../../lib/compare-tray.js';
  import { readIncludeDividends, writeIncludeDividends } from '../../lib/dividend-setting.js';
  import { getJson } from '../../lib/fetch-json.js';
  import { formatCount } from '../../lib/format.js';
  import { localizeHref } from '../../lib/i18n.js';
  import { icon } from '../../lib/icons.js';
  import * as m from '../../paraglide/messages.js';
  import { setLocale } from '../../paraglide/runtime.js';

  const locale = document.documentElement.lang;

  setLocale(locale, { reload: false });

  const byId = (id) => document.getElementById(id);

  const explorer = byId('explorer');
  const typeCards = byId('type-cards');
  const toolbar = byId('toolbar');
  const searchInput = byId('q');
  const searchClear = byId('search-clear');
  const rows = byId('rows');
  const table = byId('funds-table');
  const frame = byId('table-frame');
  const emptyState = byId('empty-state');
  const count = byId('count');
  const filterChips = byId('filter-chips');
  const clearAll = byId('clear-all');
  const pageLabel = byId('page-label');
  const pageOf = byId('page-of');
  const previousPage = byId('previous-page');
  const nextPage = byId('next-page');
  const pageSize = byId('page-size');
  const sortSelect = byId('sort-select');
  const sortDirection = byId('sort-direction');
  const includeDividends = byId('include-dividends');
  const filtersDialog = byId('filters-dialog');
  const filtersOpen = byId('filters-open');
  const filtersBadge = byId('filters-badge');
  const filtersShow = byId('filters-show');
  const columnsMenu = byId('columns-menu');
  const csvButton = byId('csv-button');
  const compareBar = byId('compare-bar');
  const compareLink = byId('compare-link');
  const compareClear = byId('compare-clear');
  const currencyButtons = document.querySelectorAll('[data-currency]');
  const toggleButtons = document.querySelectorAll('[data-toggle]');
  const sortButtons = table.querySelectorAll('[data-sort]');

  let state = parseState(location.search);
  let compared = readTray();
  let columns = readColumns();
  let data = null;
  let funds = [];
  let matching = [];
  let chips = [];

  function writeStateToUrl() {
    const query = serializeState(state);

    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  function parseLimit(text) {
    return text.trim() === '' || !Number.isFinite(Number(text)) ? null : Number(text);
  }

  // The panel's fields are filled when it opens, not on every change: rewriting a field the reader is typing in would eat the keystrokes.
  function syncFiltersDialog() {
    for (const input of filtersDialog.querySelectorAll('input[type="number"]')) {
      input.value = state[input.name] ?? '';
    }

    const managerList = byId('manager-list');

    for (const box of filtersDialog.querySelectorAll('input[name="manager"]')) {
      box.checked = state.managers.includes(box.value);
    }

    // The chosen managers come first, so they are in view when the panel opens.
    for (const box of [...managerList.querySelectorAll('input:checked')].reverse()) {
      managerList.prepend(box.closest('li'));
    }
  }

  function syncControls() {
    searchInput.value = state.q;
    searchClear.hidden = state.q === '';
    includeDividends.checked = readIncludeDividends();
    sortSelect.value = state.sort;
    pageSize.value = String(state.size);
    sortDirection.dataset.dir = state.dir === 1 ? 'asc' : 'desc';
    sortDirection.title = state.dir === 1 ? m.sort_asc() : m.sort_desc();

    for (const button of currencyButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.currency === state.currency));
    }

    for (const button of toggleButtons) {
      button.setAttribute('aria-pressed', String(state[button.dataset.toggle]));
    }

    for (const button of sortButtons) {
      const th = button.closest('th');

      if (button.dataset.sort === state.sort) {
        th.setAttribute('aria-sort', state.dir === 1 ? 'ascending' : 'descending');
      } else {
        th.removeAttribute('aria-sort');
      }
    }

    const advancedCount = advancedFilterCount(state);

    filtersBadge.hidden = advancedCount === 0;
    filtersBadge.textContent = String(advancedCount);

    chips = activeFilters(state, locale);
    filterChips.innerHTML = chips
      .map((chip, index) => `<button type="button" class="chip filter-chip" data-clear-chip="${index}" aria-label="${escapeHtml(m.remove_filter({ label: chip.label }))}">${escapeHtml(chip.label)}${icon('x', { size: 14 })}</button>`)
      .join('');
    clearAll.hidden = !hasActiveFilters(state);
  }

  function syncColumns() {
    table.dataset.show = columns.length > 0 ? columns.join(' ') : 'none';

    for (const box of columnsMenu.querySelectorAll('[data-column]')) {
      box.checked = columns.includes(box.dataset.column);
    }

    for (const button of columnsMenu.querySelectorAll('[data-preset]')) {
      const preset = COLUMN_PRESETS.find((candidate) => candidate.key === button.dataset.preset);
      const isShowing = preset.columns.length === columns.length && preset.columns.every((key) => columns.includes(key));

      button.setAttribute('aria-pressed', String(isShowing));
    }

    syncWidth();
  }

  function syncDensity() {
    const density = table.dataset.density;

    for (const button of columnsMenu.querySelectorAll('[data-density]')) {
      button.setAttribute('aria-pressed', String(button.dataset.density === density));
    }
  }

  // A table wider than the page scrolls inside its frame, and its header sticks to the frame instead of the page.
  function syncWidth() {
    frame.classList.toggle('is-wide', table.offsetWidth > frame.offsetWidth);
  }

  function syncCompare() {
    compareBar.hidden = compared.length === 0;
    compareLink.textContent = m.compare_open({ count: compared.length });
    compareLink.href = localizeHref(`/compare/${selectionQuery(compared)}`, locale);

    for (const box of rows.querySelectorAll('[data-compare]')) {
      const isCompared = compared.includes(box.dataset.compare);

      box.checked = isCompared;
      box.disabled = !isCompared && compared.length >= MAX_FUNDS;
      box.title = box.disabled ? m.compare_full({ count: MAX_FUNDS }) : '';
    }
  }

  function render() {
    matching = sortFunds(filterFunds(funds, state), state.sort, state.dir);

    const pageCount = Math.max(1, Math.ceil(matching.length / state.size));

    state.page = Math.min(state.page, pageCount - 1);

    const first = matching.length === 0 ? 0 : state.page * state.size + 1;
    const last = Math.min(matching.length, (state.page + 1) * state.size);

    typeCards.innerHTML = renderTypeCards(funds, state, locale);
    rows.innerHTML = renderRows(matching, state, data.date, locale, new Set(compared));
    table.hidden = matching.length === 0;
    emptyState.hidden = matching.length > 0;
    byId('empty-text').textContent = m.empty_text({ hint: state.inactive ? m.empty_hint() : m.empty_hint_inactive() });
    count.textContent = fundCountLabel(matching.length, locale);
    pageLabel.textContent = m.pager_range({ first: formatCount(first, locale), last: formatCount(last, locale), total: formatCount(matching.length, locale) });
    pageOf.textContent = m.pager_page({ page: state.page + 1, pages: formatCount(pageCount, locale) });
    previousPage.disabled = state.page === 0;
    nextPage.disabled = state.page >= pageCount - 1;
    filtersShow.textContent = m.filters_show({ funds: fundCountLabel(matching.length, locale) });
    csvButton.disabled = matching.length === 0;
    syncControls();
    syncCompare();
    syncWidth();
    writeStateToUrl();
  }

  function update(changes) {
    state = { ...state, page: 0, ...changes };

    // Until the data arrives, the build-time rows stay, and the first render applies these changes.
    if (funds.length > 0) {
      render();
    }
  }

  typeCards.addEventListener('click', (event) => {
    const card = event.target.closest('[data-type]');

    if (card) {
      update({ type: card.dataset.type });
    }
  });

  searchInput.addEventListener('input', () => update({ q: searchInput.value }));

  searchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      explorer.scrollIntoView({ block: 'start' });
    }
  });

  searchClear.addEventListener('click', () => {
    update({ q: '' });
    searchInput.focus();
  });

  for (const button of currencyButtons) {
    button.addEventListener('click', () => update({ currency: button.dataset.currency }));
  }

  for (const button of toggleButtons) {
    button.addEventListener('click', () => update({ [button.dataset.toggle]: !state[button.dataset.toggle] }));
  }

  for (const button of sortButtons) {
    button.addEventListener('click', () => {
      const key = button.dataset.sort;

      update({ sort: key, dir: key === state.sort ? -state.dir : defaultDirection(key) });
    });
  }

  sortSelect.addEventListener('change', () => update({ sort: sortSelect.value, dir: defaultDirection(sortSelect.value) }));
  sortDirection.addEventListener('click', () => update({ dir: -state.dir }));
  pageSize.addEventListener('change', () => update({ size: Number(pageSize.value) }));

  filterChips.addEventListener('click', (event) => {
    const chip = event.target.closest('[data-clear-chip]');

    if (chip) {
      update(chips[Number(chip.dataset.clearChip)].clear);
    }
  });

  function clearEverything() {
    update(clearedFilters(state));
    syncFiltersDialog();
  }

  clearAll.addEventListener('click', clearEverything);
  byId('empty-clear').addEventListener('click', clearEverything);

  function turnPage(step) {
    // The build-time page has no data behind it yet; turning it would render an empty table.
    if (funds.length === 0) {
      return;
    }

    state.page += step;
    render();
    explorer.scrollIntoView({ block: 'start' });
  }

  previousPage.addEventListener('click', () => turnPage(-1));
  nextPage.addEventListener('click', () => turnPage(1));

  rows.addEventListener('click', (event) => {
    const row = event.target.closest('tr[data-href]');

    // A click on the link or the compare checkbox, or one that ends a text selection, keeps its normal behaviour.
    if (!row || event.target.closest('a, .c-compare') || getSelection().toString()) {
      return;
    }

    if (event.metaKey || event.ctrlKey) {
      window.open(row.dataset.href, '_blank');
    } else {
      location.href = row.dataset.href;
    }
  });

  rows.addEventListener('change', (event) => {
    const box = event.target.closest('[data-compare]');

    if (box) {
      compared = toggleInTray(box.dataset.compare);
      syncCompare();
    }
  });

  compareClear.addEventListener('click', () => {
    writeTray([]);
    compared = [];
    syncCompare();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== searchInput && !event.target.closest('input, textarea, select')) {
      event.preventDefault();
      searchInput.focus();
    }
  });

  includeDividends.addEventListener('change', () => {
    writeIncludeDividends(includeDividends.checked);

    if (data) {
      funds = prepareFunds(data, includeDividends.checked);
      update({ page: state.page });
    }
  });

  // The filter panel: a modal dialog, so the browser traps focus, closes it on Escape, and returns focus to the button.
  filtersOpen.addEventListener('click', () => {
    syncFiltersDialog();
    filtersDialog.showModal();
  });

  filtersDialog.addEventListener('click', (event) => {
    if (event.target === filtersDialog) {
      filtersDialog.close();
    }
  });

  let limitTimer;

  filtersDialog.addEventListener('input', (event) => {
    const input = event.target;

    if (input.type !== 'number') {
      return;
    }

    clearTimeout(limitTimer);
    limitTimer = setTimeout(() => update({ [input.name]: parseLimit(input.value) }), 250);
  });

  filtersDialog.addEventListener('change', (event) => {
    if (event.target.name === 'manager') {
      update({ managers: [...filtersDialog.querySelectorAll('input[name="manager"]:checked')].map((box) => box.value) });
    }
  });

  byId('manager-search').addEventListener('keydown', (event) => {
    // Enter would submit the panel's form and close it.
    if (event.key === 'Enter') {
      event.preventDefault();
    }
  });

  byId('manager-search').addEventListener('input', (event) => {
    const words = event.target.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;

    for (const item of byId('manager-list').children) {
      item.hidden = !words.every((word) => item.dataset.name.includes(word));
      shown += item.hidden ? 0 : 1;
    }

    byId('manager-none').hidden = shown > 0;
  });

  byId('filters-reset').addEventListener('click', () => {
    update({ managers: [], ...Object.fromEntries([...filtersDialog.querySelectorAll('input[type="number"]')].map((input) => [input.name, null])) });
    syncFiltersDialog();
  });

  // The columns menu and the info popover are native popovers; this places them under their buttons.
  function placeUnder(popover) {
    popover.addEventListener('beforetoggle', (event) => {
      if (event.newState !== 'open') {
        return;
      }

      const button = document.querySelector(`[popovertarget="${popover.id}"]`);
      const rect = button.getBoundingClientRect();
      const alignRight = rect.left > innerWidth / 2;

      popover.style.top = `${rect.bottom + 8}px`;
      popover.style.left = alignRight ? 'auto' : `${Math.max(rect.left, 8)}px`;
      popover.style.right = alignRight ? `${Math.max(innerWidth - rect.right, 8)}px` : 'auto';
    });
  }

  placeUnder(columnsMenu);
  placeUnder(byId('dividends-info'));

  columnsMenu.addEventListener('change', (event) => {
    if (event.target.dataset.column) {
      columns = [...columnsMenu.querySelectorAll('[data-column]')].filter((box) => box.checked).map((box) => box.dataset.column);
      writeColumns(columns);
      syncColumns();
    }
  });

  columnsMenu.addEventListener('click', (event) => {
    const preset = event.target.closest('[data-preset]');
    const density = event.target.closest('[data-density]');

    if (preset) {
      columns = COLUMN_PRESETS.find((candidate) => candidate.key === preset.dataset.preset).columns;
      writeColumns(columns);
      syncColumns();
    }

    if (density) {
      table.dataset.density = density.dataset.density;
      writeDensity(density.dataset.density);
      syncDensity();
    }
  });

  csvButton.addEventListener('click', () => {
    const file = new Blob([buildCsv(matching, columns)], { type: 'text/csv;charset=utf-8' });
    const link = document.createElement('a');

    link.href = URL.createObjectURL(file);
    link.download = `reksadana-id-${data.date}.csv`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  // The toolbar sticks under the header, and the table header sticks under the toolbar.
  new ResizeObserver(() => {
    document.documentElement.style.setProperty('--toolbar-h', `${toolbar.offsetHeight}px`);
    syncWidth();
  }).observe(toolbar);

  new ResizeObserver(syncWidth).observe(frame);

  table.dataset.density = readDensity();
  syncColumns();
  syncDensity();
  syncControls();
  syncCompare();

  // A shared link opens a filtered view, so the build-time rows, which are the default view, would flash first.
  if (serializeState(state) !== '') {
    rows.innerHTML = renderSkeletonRows(state.size);
  }

  data = await getJson('/explorer.json');

  if (data === null) {
    count.textContent = m.fund_list_failed();
  } else {
    funds = prepareFunds(data, includeDividends.checked);
    render();
  }
</script>
