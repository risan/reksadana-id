---
import Base from '../../layouts/Base.astro';
import { loadFundSummaries } from '../../lib/data.js';
import { DEFAULT_STATE, PAGE_SIZE, filterFunds, fundCountLabel, prepareFunds, renderRows, renderTypeStrip, sortFunds } from '../../lib/explorer.js';
import { formatCount } from '../../lib/format.js';
import { anchor, localePaths, localizeHref } from '../../lib/i18n.js';
import * as m from '../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';
const data = loadFundSummaries();
const funds = prepareFunds(data);
const initial = sortFunds(filterFunds(funds, DEFAULT_STATE), DEFAULT_STATE.sort, DEFAULT_STATE.dir);
const inactiveCount = funds.filter((fund) => !fund.active).length;
const dividendFundCount = funds.filter((fund) => fund.total).length;

const COLUMNS = [
  { key: null, label: m.compare_col_header(), className: 'c-compare', hidden: true },
  { key: 'name', label: m.col_fund(), className: 'c-fund' },
  { key: null, label: m.col_nav(), className: 'num c-nav' },
  { key: 'return_1m', label: m.period_1m(), className: 'num c-1m', title: m.col_1m_title() },
  { key: 'return_ytd', label: m.period_ytd(), className: 'num c-ytd', title: m.col_ytd_title() },
  { key: 'return_1y', label: m.period_1y(), className: 'num c-1y', title: m.col_1y_title() },
  { key: null, label: m.col_spark(), className: 'c-spark' },
  { key: 'return_3y', label: m.period_3y(), className: 'num c-3y', title: m.col_3y_title() },
  { key: 'aum', label: m.col_aum(), className: 'num c-aum', title: m.col_aum_title() },
  { key: null, label: m.col_buy(), className: 'c-buy' },
];
---

<Base title="Reksadana ID" section="funds">
  <div class="intro">
    <h1 class="page-title">{m.home_title()}</h1>
    <p class="lede" set:html={m.home_lede({ count: formatCount(funds.length, locale), downloadLink: anchor(localizeHref('/download/', locale), m.home_lede_download()) })} />
  </div>

  <div class="type-strip" id="type-strip" role="group" aria-label={m.type_strip_label()} set:html={renderTypeStrip(funds, DEFAULT_STATE, locale)} />

  <form class="controls" id="controls" onsubmit="return false">
    <label class="search">
      <span class="visually-hidden">{m.search_label()}</span>
      <input id="q" name="q" type="search" placeholder={m.search_placeholder()} autocomplete="off" spellcheck="false" />
      <kbd aria-hidden="true">/</kbd>
    </label>
    <div class="seg" role="group" aria-label={m.currency_label()}>
      <button type="button" data-currency="" aria-pressed="true">{m.currency_all()}</button>
      <button type="button" data-currency="IDR" aria-pressed="false">IDR</button>
      <button type="button" data-currency="USD" aria-pressed="false">USD</button>
    </div>
    <label class="check"><input type="checkbox" name="sharia" /> {m.filter_sharia()}</label>
    <label class="check"><input type="checkbox" name="bibit" /> {m.filter_bibit()}</label>
    <label class="check"><input type="checkbox" name="makmur" /> {m.filter_makmur()}</label>
    <label class="check" title={m.filter_inactive_title()}><input type="checkbox" name="inactive" /> {m.filter_inactive({ count: formatCount(inactiveCount, locale) })}</label>
    <label class="check" title={m.dividends_toggle_help({ count: formatCount(dividendFundCount, locale) })}><input type="checkbox" id="include-dividends" /> {m.dividends_toggle()}</label>
    <span class="result-count" id="count" aria-live="polite">{fundCountLabel(initial.length, locale)}</span>
  </form>

  <div class="table-scroll">
    <table class="tbl funds-table">
      <thead>
        <tr>
          {COLUMNS.map((column) => (
            <th class={column.className} title={column.title} aria-sort={column.key === DEFAULT_STATE.sort ? 'descending' : undefined}>
              {column.key ? <button type="button" class="sort" data-sort={column.key}>{column.label}</button> : column.hidden ? <span class="visually-hidden">{column.label}</span> : column.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody id="rows" set:html={renderRows(initial, DEFAULT_STATE, data.date, locale)} />
    </table>
  </div>

  <div class="pager">
    <span class="muted" id="page-label">{m.pager_range({ first: formatCount(Math.min(1, initial.length), locale), last: formatCount(Math.min(PAGE_SIZE, initial.length), locale), total: formatCount(initial.length, locale) })}</span>
    <button class="btn" type="button" id="previous-page" disabled>&larr; {m.pager_previous()}</button>
    <button class="btn" type="button" id="next-page" disabled={initial.length <= PAGE_SIZE}>{m.pager_next()} &rarr;</button>
  </div>

  <div class="compare-bar" id="compare-bar" hidden>
    <a class="btn btn-ink" id="compare-link" href={localizeHref('/compare/', locale)}></a>
    <button class="btn" type="button" id="compare-clear">{m.compare_clear()}</button>
  </div>

  <details class="method">
    <summary>{m.method_title()}</summary>
    <ul>
      <li set:html={m.method_nav()} />
      <li set:html={m.method_returns()} />
      <li set:html={m.method_median()} />
      <li set:html={m.method_aum()} />
      <li set:html={m.method_inactive()} />
      <li set:html={m.method_flag()} />
    </ul>
  </details>
</Base>

<style is:global>
  .type-strip {
    display: grid;
    grid-template-columns: repeat(8, minmax(118px, 1fr));
    overflow-x: auto;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .type-cell {
    display: grid;
    gap: 1px;
    padding: 8px 10px 9px;
    border: 0;
    border-left: 1px solid var(--rule);
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .type-cell:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .type-cell:hover {
    background: var(--panel);
  }

  .type-cell[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .type-cell:first-child[aria-pressed='true'] {
    padding-left: 10px;
  }

  .type-name {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 600;
    white-space: nowrap;
  }

  .type-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
  }

  .type-en {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
  }

  .type-median {
    margin-top: 5px;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .type-median small {
    margin-left: 5px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }

  .type-cell[aria-pressed='true'] .type-count,
  .type-cell[aria-pressed='true'] .type-en,
  .type-cell[aria-pressed='true'] .type-median small {
    color: inherit;
    opacity: 0.7;
  }

  .type-cell[aria-pressed='true'] .type-median {
    color: inherit;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 0;
  }

  .search {
    position: relative;
    flex: 0 1 340px;
  }

  .search input {
    width: 100%;
    padding-right: 30px;
  }

  .search kbd {
    position: absolute;
    top: 7px;
    right: 8px;
  }

  .search input:focus + kbd,
  .search input:not(:placeholder-shown) + kbd {
    display: none;
  }

  .check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    white-space: nowrap;
    cursor: pointer;
  }

  .check input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--ink);
  }

  .result-count {
    margin-left: auto;
    color: var(--muted);
  }

  .funds-table {
    min-width: 860px;
  }

  .funds-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--paper);
  }

  .funds-table .sort {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .funds-table .sort:hover {
    color: var(--ink);
  }

  .funds-table th[aria-sort] {
    color: var(--ink);
    font-weight: 650;
  }

  .funds-table th[aria-sort='descending'] .sort::after {
    content: ' \2193';
  }

  .funds-table th[aria-sort='ascending'] .sort::after {
    content: ' \2191';
  }

  .funds-table tbody tr {
    cursor: pointer;
  }

  .funds-table .c-compare {
    width: 24px;
    padding-right: 4px;
    cursor: default;
  }

  .funds-table .c-compare input {
    width: 14px;
    height: 14px;
    margin: 2px 0 0;
    accent-color: var(--ink);
    cursor: pointer;
  }

  .funds-table .c-compare input:disabled {
    cursor: default;
  }

  .compare-bar {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    border-top: 1px solid var(--rule-strong);
    background: var(--paper);
  }

  .funds-table tbody tr:hover {
    background: var(--panel);
  }

  .funds-table td {
    padding-top: 7px;
    padding-bottom: 7px;
  }

  .funds-table .c-fund {
    min-width: 260px;
  }

  .funds-table .c-fund a {
    color: var(--ink);
    font-weight: 550;
  }

  .funds-table .sub {
    margin-top: 1px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
  }

  .funds-table .c-fund .sub .mono {
    color: var(--faint);
    font-size: 11px;
  }

  .funds-table .c-1y {
    font-weight: 650;
  }

  .funds-table .c-spark {
    width: 84px;
    padding-top: 6px;
  }

  .funds-table .c-buy {
    white-space: nowrap;
  }

  .funds-table .tag {
    font-size: 11px;
    line-height: 15px;
  }

  .tag-stale {
    border-color: var(--warn);
    color: var(--warn);
  }

  .flag {
    display: inline-block;
    width: 13px;
    height: 13px;
    margin-left: 4px;
    border-radius: 50%;
    background: var(--warn);
    color: var(--paper);
    font-size: 10px;
    font-weight: 700;
    line-height: 13px;
    text-align: center;
    vertical-align: 1px;
  }

  .spark {
    display: block;
    overflow: visible;
  }

  .spark polyline {
    fill: none;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .spark line {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .spark.up polyline {
    stroke: var(--up);
  }

  .spark.down polyline {
    stroke: var(--down);
  }

  .spark.flat polyline {
    stroke: var(--muted);
  }

  .empty-row td {
    padding: 28px 0;
    color: var(--muted);
    text-align: center;
    cursor: default;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px 0;
  }

  .pager .muted {
    margin-right: 8px;
  }

  .method {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 13.5px;
  }

  .method summary {
    color: var(--ink);
    font-weight: 600;
    cursor: pointer;
  }

  .method ul {
    max-width: 80ch;
    margin: 8px 0 0;
    padding-left: 18px;
    line-height: 1.55;
  }

  .method li + li {
    margin-top: 4px;
  }

  @media (max-width: 960px) {
    .funds-table {
      min-width: 0;
    }

    .funds-table .c-1m,
    .funds-table .c-3y,
    .funds-table .c-buy {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .funds-table .c-nav,
    .funds-table .c-ytd,
    .funds-table .c-aum {
      display: none;
    }

    .funds-table .c-fund {
      min-width: 0;
    }

    .result-count {
      margin-left: 0;
    }

    .search {
      flex-basis: 100%;
    }
  }
</style>

<script>
  import { DEFAULT_STATE, PAGE_SIZE, filterFunds, fundCountLabel, prepareFunds, renderRows, renderTypeStrip, sortFunds } from '../../lib/explorer.js';
  import { MAX_FUNDS, selectionQuery } from '../../lib/compare.js';
  import { readTray, toggleInTray, writeTray } from '../../lib/compare-tray.js';
  import { readIncludeDividends, writeIncludeDividends } from '../../lib/dividend-setting.js';
  import { formatCount } from '../../lib/format.js';
  import { localizeHref } from '../../lib/i18n.js';
  import * as m from '../../paraglide/messages.js';
  import { setLocale } from '../../paraglide/runtime.js';

  const locale = document.documentElement.lang;

  setLocale(locale, { reload: false });

  const typeStrip = document.getElementById('type-strip');
  const controls = document.getElementById('controls');
  const searchInput = document.getElementById('q');
  const rows = document.getElementById('rows');
  const count = document.getElementById('count');
  const pageLabel = document.getElementById('page-label');
  const previousPage = document.getElementById('previous-page');
  const nextPage = document.getElementById('next-page');
  const currencyButtons = controls.querySelectorAll('[data-currency]');
  const sortButtons = document.querySelectorAll('[data-sort]');
  const checkboxes = controls.querySelectorAll('input[type="checkbox"][name]');
  const includeDividends = document.getElementById('include-dividends');
  const compareBar = document.getElementById('compare-bar');
  const compareLink = document.getElementById('compare-link');
  const compareClear = document.getElementById('compare-clear');

  const TEXT_SORTS = new Set(['name']);
  const BOOLEAN_KEYS = ['sharia', 'bibit', 'makmur', 'inactive'];

  let state = readStateFromUrl();
  let compared = readTray();
  let data = null;
  let funds = [];
  let dataDate = '';

  function readStateFromUrl() {
    const params = new URLSearchParams(location.search);
    const next = { ...DEFAULT_STATE };

    next.q = params.get('q') ?? '';
    next.type = params.get('type') ?? '';
    next.currency = params.get('currency') ?? '';
    next.sort = params.get('sort') ?? DEFAULT_STATE.sort;
    next.dir = params.get('dir') === 'asc' ? 1 : params.get('dir') === 'desc' ? -1 : TEXT_SORTS.has(next.sort) ? 1 : -1;
    next.page = Math.max(0, Number(params.get('page') ?? 1) - 1) || 0;

    for (const key of BOOLEAN_KEYS) {
      next[key] = params.get(key) === '1';
    }

    return next;
  }

  function writeStateToUrl() {
    const params = new URLSearchParams();

    for (const key of ['q', 'type', 'currency']) {
      if (state[key]) {
        params.set(key, state[key]);
      }
    }

    for (const key of BOOLEAN_KEYS) {
      if (state[key]) {
        params.set(key, '1');
      }
    }

    if (state.sort !== DEFAULT_STATE.sort || state.dir !== DEFAULT_STATE.dir) {
      params.set('sort', state.sort);
      params.set('dir', state.dir === 1 ? 'asc' : 'desc');
    }

    if (state.page > 0) {
      params.set('page', String(state.page + 1));
    }

    const query = params.toString();

    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  function syncControls() {
    searchInput.value = state.q;

    for (const button of currencyButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.currency === state.currency));
    }

    for (const checkbox of checkboxes) {
      checkbox.checked = state[checkbox.name];
    }

    for (const button of sortButtons) {
      const th = button.closest('th');

      if (button.dataset.sort === state.sort) {
        th.setAttribute('aria-sort', state.dir === 1 ? 'ascending' : 'descending');
      } else {
        th.removeAttribute('aria-sort');
      }
    }
  }

  // On a narrow screen the strip scrolls sideways, and the selected type may start out of view.
  function revealSelectedType() {
    const selected = typeStrip.querySelector('[aria-pressed="true"]');

    if (!selected) {
      return;
    }

    const left = selected.offsetLeft - typeStrip.offsetLeft;
    const right = left + selected.offsetWidth;

    if (left < typeStrip.scrollLeft || right > typeStrip.scrollLeft + typeStrip.clientWidth) {
      typeStrip.scrollLeft = left;
    }
  }

  function syncCompare() {
    compareBar.hidden = compared.length === 0;
    compareLink.textContent = m.compare_open({ count: compared.length });
    compareLink.href = localizeHref(`/compare/${selectionQuery(compared)}`, locale);

    for (const box of rows.querySelectorAll('[data-compare]')) {
      const isCompared = compared.includes(box.dataset.compare);

      box.checked = isCompared;
      box.disabled = !isCompared && compared.length >= MAX_FUNDS;
      box.title = box.disabled ? m.compare_full({ count: MAX_FUNDS }) : '';
    }
  }

  function render() {
    const matching = sortFunds(filterFunds(funds, state), state.sort, state.dir);
    const pageCount = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));

    state.page = Math.min(state.page, pageCount - 1);

    const first = matching.length === 0 ? 0 : state.page * PAGE_SIZE + 1;
    const last = Math.min(matching.length, (state.page + 1) * PAGE_SIZE);

    typeStrip.innerHTML = renderTypeStrip(funds, state, locale);
    revealSelectedType();
    rows.innerHTML = renderRows(matching, state, dataDate, locale, new Set(compared));
    count.textContent = fundCountLabel(matching.length, locale);
    pageLabel.textContent = m.pager_range({ first: formatCount(first, locale), last: formatCount(last, locale), total: formatCount(matching.length, locale) });
    previousPage.disabled = state.page === 0;
    nextPage.disabled = state.page >= pageCount - 1;
    syncControls();
    syncCompare();
    writeStateToUrl();
  }

  function update(changes) {
    state = { ...state, page: 0, ...changes };

    // Until the data arrives, the build-time rows stay, and the first render applies these changes.
    if (funds.length > 0) {
      render();
    }
  }

  typeStrip.addEventListener('click', (event) => {
    const cell = event.target.closest('[data-type]');

    if (cell) {
      update({ type: cell.dataset.type });
    }
  });

  searchInput.addEventListener('input', () => update({ q: searchInput.value }));

  for (const button of currencyButtons) {
    button.addEventListener('click', () => update({ currency: button.dataset.currency }));
  }

  for (const checkbox of checkboxes) {
    checkbox.addEventListener('change', () => update({ [checkbox.name]: checkbox.checked }));
  }

  for (const button of sortButtons) {
    button.addEventListener('click', () => {
      const key = button.dataset.sort;
      const dir = key === state.sort ? -state.dir : TEXT_SORTS.has(key) ? 1 : -1;

      update({ sort: key, dir });
    });
  }

  function turnPage(step) {
    // The build-time page has no data behind it yet; turning it would render an empty table.
    if (funds.length === 0) {
      return;
    }

    state.page += step;
    render();
    rows.closest('table').scrollIntoView({ block: 'start' });
  }

  previousPage.addEventListener('click', () => turnPage(-1));
  nextPage.addEventListener('click', () => turnPage(1));

  rows.addEventListener('click', (event) => {
    const row = event.target.closest('tr[data-href]');

    // A click on the link or the compare checkbox, or one that ends a text selection, keeps its normal behaviour.
    if (!row || event.target.closest('a, .c-compare') || getSelection().toString()) {
      return;
    }

    if (event.metaKey || event.ctrlKey) {
      window.open(row.dataset.href, '_blank');
    } else {
      location.href = row.dataset.href;
    }
  });

  rows.addEventListener('change', (event) => {
    const box = event.target.closest('[data-compare]');

    if (box) {
      compared = toggleInTray(box.dataset.compare);
      syncCompare();
    }
  });

  compareClear.addEventListener('click', () => {
    writeTray([]);
    compared = [];
    syncCompare();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== searchInput && !event.target.closest('input, textarea, select')) {
      event.preventDefault();
      searchInput.focus();
    }
  });

  includeDividends.addEventListener('change', () => {
    writeIncludeDividends(includeDividends.checked);

    if (data) {
      funds = prepareFunds(data, includeDividends.checked);
      update({});
    }
  });

  includeDividends.checked = readIncludeDividends();
  syncControls();
  syncCompare();

  const response = await fetch('/explorer.json');

  data = await response.json();
  funds = prepareFunds(data, includeDividends.checked);
  dataDate = data.date;
  render();
</script>
