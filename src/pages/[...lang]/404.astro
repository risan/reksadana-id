---
import Base from '../../layouts/Base.astro';
import { localePaths, localizeHref } from '../../lib/i18n.js';
import { icon } from '../../lib/icons.js';
import * as m from '../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';

const LINKS = [
  ['/', m.nav_funds(), 'table-2'],
  ['/compare/', m.nav_compare(), 'scale'],
  ['/download/', m.nav_download(), 'download'],
];
---

<Base title={m.not_found_title()} indexable={false} alternatePath="/">
  <section class="not-found">
    <p class="not-found-code mono" aria-hidden="true">404</p>
    <h1 class="page-title">{m.not_found_title()}</h1>
    <p class="lede">{m.not_found_text()}</p>
    <form class="not-found-search" action={localizeHref('/', locale)} method="get" role="search">
      <label class="search">
        <span class="visually-hidden">{m.search_label()}</span>
        <Fragment set:html={icon('search')} />
        <input name="q" type="search" placeholder={m.search_placeholder()} autocomplete="off" spellcheck="false" />
      </label>
      <button class="btn btn-primary" type="submit">{m.search_button()}</button>
    </form>
    <nav class="not-found-links">
      {LINKS.map(([href, label, iconName]) => <a href={localizeHref(href, locale)}><Fragment set:html={icon(iconName, { size: 14 })} />{label}</a>)}
    </nav>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    max-width: 520px;
    padding-top: var(--s-6);
  }

  .not-found-code {
    color: var(--soga);
    font-size: var(--fs-md);
    line-height: 1;
  }

  .not-found-search {
    display: flex;
    gap: var(--s-3);
    width: 100%;
  }

  .not-found-search .search {
    flex: 1;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }

  .not-found-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-weight: var(--fw-label);
  }
</style>
