---
import Base from '../../layouts/Base.astro';
import { fundIdOfBibitSymbol, fundPerformance, isActive, latestAum, listFundIds, loadFundRecord, shortManagerName, staleSourceDate } from '../../lib/data.js';
import { changeClass, formatChange, formatDate, formatMoney, formatMonth, formatNav, formatNumber, formatPercent } from '../../lib/format.js';
import { englishTypeName } from '../../lib/fund-types.js';
import { REFERRALS, bibitFundUrl } from '../../lib/referrals.js';
import { RETURN_PERIODS, SOURCE_LABELS, fundCurrency, largeMoves, pickAumHistory, pickNavHistory } from '../../lib/series.js';

export function getStaticPaths() {
  return listFundIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const fund = loadFundRecord(id);
const info = fund.fund;
const { kontan, bareksa, makmur } = fund;
const hasBibit = info.sources.bibit.length > 0;

const history = pickNavHistory(fund);
const performance = fundPerformance(fund, history);
const lastPoint = history.points.at(-1);
const navValue = lastPoint?.value ?? null;
const navDate = history.frozenSince ?? lastPoint?.date ?? null;
const active = isActive(navDate, lastPoint?.source);
const sourceDataDate = staleSourceDate(lastPoint?.source);
const currency = fundCurrency(fund);
const aum = latestAum(fund);
const hasAumHistory = pickAumHistory(fund).points.length > 0;
const moves = largeMoves(history.points).reverse();

const PERIOD_LABELS = { '1d': '1D', '1m': '1M', '3m': '3M', ytd: 'YTD', '1y': '1Y', '3y': '3Y', '5y': '5Y', '10y': '10Y', all: 'All' };
const TABLE_PERIODS = RETURN_PERIODS.filter((period) => period !== '1d');
const ret = (period) => performance.simplereturn?.[period] ?? null;

// Bibit stores a fraction; a few funds carry a raw number that cannot be a ratio, so those show as missing.
const expenseRatio = fund.expenseratio?.percentage;
const validExpenseRatio = typeof expenseRatio === 'number' && expenseRatio >= 0 && expenseRatio < 1 ? expenseRatio : null;

function formatFee(fee) {
  if (!fee) {
    return '—';
  }

  if (fee.type === 'percent') {
    return `${formatNumber(fee.value, 2)}%`;
  }

  return `${fee.currency ?? ''} ${formatNumber(fee.value)}`.trim();
}

// Document URLs come from scraped data, so never link anything but http(s), such as a javascript: URL.
function isWebUrl(url) {
  return typeof url === 'string' && /^https?:\/\//i.test(url);
}

// Dividend dates are midnight in Jakarta (UTC+7), stored as UTC.
function jakartaDate(isoTimestamp) {
  return new Date(new Date(isoTimestamp).getTime() + 7 * 60 * 60 * 1000).toISOString().slice(0, 10);
}

const ASSET_CLASSES = [
  { key: 'equity', label: 'Equity', color: 'var(--alloc-equity)', pattern: /saham|ekuitas|equit|stock/i },
  { key: 'bonds', label: 'Bonds', color: 'var(--alloc-bonds)', pattern: /obligasi|sukuk|utang|hutang|pendapatan tetap|fixed income|bond/i },
  { key: 'money', label: 'Money market', color: 'var(--alloc-money)', pattern: /pasar uang|deposit|kas|cash|money|likuid|setara/i },
  { key: 'other', label: 'Other', color: 'var(--alloc-other)', pattern: /.*/ },
];

function assetClassOf(name) {
  return ASSET_CLASSES.find((assetClass) => assetClass.pattern.test(name));
}

// Bibit's mix uses the manager's own names; the bar groups them into four classes, the list keeps the names.
const assets = (fund.asset ?? [])
  .filter((asset) => asset.percentage > 0)
  .map((asset) => ({ ...asset, assetClass: assetClassOf(asset.name) }))
  .sort((a, b) => ASSET_CLASSES.indexOf(a.assetClass) - ASSET_CLASSES.indexOf(b.assetClass) || b.percentage - a.percentage);
const assetTotal = assets.reduce((sum, asset) => sum + asset.percentage, 0);

const BAREKSA_CLASSES = [
  ['saham', 'equity'],
  ['obligasi', 'bonds'],
  ['pasar_uang', 'money'],
  ['lainnya', 'other'],
];
const ALLOCATION_MONTHS = 24;
const allocationHistory = (bareksa?.allocation ?? [])
  .filter((row) => BAREKSA_CLASSES.some(([column]) => row[column] > 0))
  .slice(-ALLOCATION_MONTHS);

const MIX_WIDTH = 600;
const MIX_HEIGHT = 120;
const MIX_GAP = 2;
const mixColumnWidth = allocationHistory.length ? (MIX_WIDTH - MIX_GAP * (allocationHistory.length - 1)) / allocationHistory.length : 0;
const mixColumns = allocationHistory.map((row, index) => {
  const total = BAREKSA_CLASSES.reduce((sum, [column]) => sum + (row[column] ?? 0), 0);
  let y = MIX_HEIGHT;

  const segments = BAREKSA_CLASSES.map(([column, key]) => {
    const share = (row[column] ?? 0) / total;
    const height = share * MIX_HEIGHT;

    y -= height;

    return { key, share, y, height, color: ASSET_CLASSES.find((assetClass) => assetClass.key === key).color };
  }).filter((segment) => segment.height > 0);

  return { date: row.date, x: index * (mixColumnWidth + MIX_GAP), segments };
});
const latestMix = mixColumns.at(-1);

const holdings = fund.holding ?? [];
const dividends = [...(fund.dividends ?? [])].sort((a, b) => b.date.localeCompare(a.date));
const factsheets = [...(fund.documents?.factsheets ?? [])].filter((document) => isWebUrl(document.file)).sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const prospectus = [...(fund.documents?.prospectus ?? [])].filter((document) => isWebUrl(document.file)).reverse();
const makmurDocuments = [
  ['Prospectus', makmur?.data.prospectus],
  ['Factsheet', makmur?.data.factsheet],
].filter(([, url]) => isWebUrl(url));
const switchables = fund.switchables ?? [];
const buyLinks = [
  fund.tradeable && { ...REFERRALS.bibit, url: bibitFundUrl(fund.symbol) },
  makmur && { ...REFERRALS.makmur, url: makmur.url },
].filter(Boolean);

const typeEnglish = englishTypeName(info.type);
const launchDate = info.launch_date ?? fund.released_date ?? null;
const manager = shortManagerName(info.manager);
const riskProfile = ['Low', 'Moderate', 'High'].includes(fund.riskprofile) ? fund.riskprofile : null;
const returnsNote = performance.source
  ? `Change in NAV, computed from the ${SOURCE_LABELS[history.primary]} history.${
      dividends.length > 0 ? ' This fund pays dividends, which these figures leave out, so its total return is higher.' : ''
    }`
  : null;

const details = [
  ['Type', info.type ? `${info.type}${typeEnglish ? ` (${typeEnglish})` : ''}` : null],
  ['Manager', info.manager],
  ['Custodian bank', fund.custodian_bank?.name],
  ['Currency', currency ?? 'Not stated'],
  ['Launched', launchDate ? formatDate(launchDate) : null],
  ['Risk profile', riskProfile],
  ['Minimum buy', fund.minbuy ? `${currency ?? ''} ${formatNumber(fund.minbuy)}`.trim() : null],
  ['Expense ratio', validExpenseRatio === null ? null : formatPercent(validExpenseRatio)],
  ['Subscription fee', fund.fee ? formatFee(fund.fee.subscription) : null],
  ['Redemption fee', fund.fee ? formatFee(fund.fee.redemption) : null],
  ['Switch fee', fund.fee ? formatFee(fund.fee.switch) : null],
].filter(([, value]) => value !== null && value !== undefined && value !== '');

function threeYearSub() {
  const threeYearsPerYear = performance.cagr?.['3y'] ?? null;

  if (threeYearsPerYear !== null) {
    return `3Y: ${formatChange(threeYearsPerYear)} a year`;
  }

  return ret('ytd') === null ? '' : `YTD: ${formatChange(ret('ytd'))}`;
}

const figures = [
  {
    label: active ? 'NAV per unit' : 'Last NAV',
    value: navValue === null ? '—' : formatNav(navValue),
    unit: currency,
    sub: navDate ? formatDate(navDate) : 'No NAV yet',
    change: active ? ret('1d') : null,
  },
  { label: '1-year return', value: formatChange(ret('1y')), className: changeClass(ret('1y')), sub: threeYearSub() },
  { label: 'Worst fall, 1 year', value: formatPercent(performance.maxdrawdown?.['1y'] ?? null), sub: 'Peak to bottom' },
  { label: 'Fund size', value: formatMoney(aum?.value ?? null, currency), sub: aum ? formatMonth(aum.date) : '' },
  { label: 'Expense ratio', value: validExpenseRatio === null ? '—' : formatPercent(validExpenseRatio), sub: 'Yearly cost' },
].filter((figure, index) => index === 0 || figure.value !== '—');

const sources = [
  hasBibit && { name: 'Bibit', url: 'https://app.bibit.id/', what: 'fund data, NAV, AUM', ids: info.sources.bibit },
  kontan && { name: 'Kontan', url: `https://pusatdata.kontan.co.id/reksadana/produk/${kontan.id}`, what: `daily NAV, last 12 months`, ids: info.sources.kontan },
  bareksa && { name: 'Bareksa', url: `https://www.bareksa.com/id/data/reksadana/${bareksa.id}/`, what: 'daily NAV, monthly AUM, units, asset mix', ids: info.sources.bareksa },
  makmur && { name: 'Makmur', url: makmur.url, what: 'documents', ids: info.sources.makmur },
].filter(Boolean);
---

<Base title={`${info.name} (${id})`} description={`NAV history, returns, fund size, and documents for ${info.name}, a reksa dana managed by ${manager ?? 'an Indonesian investment manager'}.`} section="funds">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Funds</a>
    {info.type && <><span aria-hidden="true">/</span><a href={`/?type=${encodeURIComponent(info.type)}`}>{info.type}</a></>}
    <span aria-hidden="true">/</span><span class="mono">{id}</span>
  </nav>

  <header class="fund-head">
    <h1 class="page-title">{info.name}</h1>
    {info.other_names.length > 0 && <p class="fund-aka muted small">Also known as {info.other_names.join(' · ')}</p>}
    <p class="fund-meta">
      {manager && <span>{manager}</span>}
      {info.type && <span>{info.type}{typeEnglish && <span class="muted"> · {typeEnglish}</span>}</span>}
      {info.sharia ? <span class="tag">Syariah</span> : null}
      {info.etf ? <span class="tag">ETF</span> : null}
      {info.index ? <span class="tag">Index</span> : null}
      {currency === 'USD' && <span class="tag">USD</span>}
      {dividends.length > 0 && <span class="tag">Pays dividends</span>}
      {riskProfile && <span class="tag">{riskProfile} risk</span>}
    </p>
  </header>

  {
    !active && (
      <p class="notice">
        <span>
          <strong>Inactive.</strong>{' '}
          {history.frozenSince
            ? `The NAV has not changed since ${formatDate(navDate)}, although some sources still list it.`
            : navDate
              ? `No NAV since ${formatDate(navDate)}.`
              : 'No NAV reported.'}{' '}
          The fund may be closed, merged, or no longer reported.
        </span>
      </p>
    )
  }

  {
    sourceDataDate && (
      <p class="muted small data-freshness">
        NAV from {SOURCE_LABELS[lastPoint.source]}, which is not updated daily: its data runs up to {formatDate(sourceDataDate)}.
      </p>
    )
  }

  <dl class="figures">
    {figures.map((figure) => (
      <div>
        <dt>{figure.label}</dt>
        <dd class={`figure-value ${figure.className ?? ''}`}>{figure.value}{figure.unit && figure.value !== '—' && <span class="unit">{figure.unit}</span>}</dd>
        <dd class="figure-sub">
          {figure.sub}
          {figure.change !== null && figure.change !== undefined && <span class={changeClass(figure.change)}> · {formatChange(figure.change)} 1D</span>}
        </dd>
      </div>
    ))}
  </dl>

  {
    moves.length > 0 && (
      <p class="notice moves">
        <span>
          <strong>Large one-day {moves.length === 1 ? 'move' : 'moves'} in the NAV:</strong>{' '}
          {moves.slice(0, 3).map((move, index) => (
            <>
              {index > 0 && '; '}
              {formatChange(move.change, 1)} on {formatDate(move.date)}
            </>
          ))}
          {moves.length > 3 && `; and ${moves.length - 3} more`}. Returns that span {moves.length === 1 ? 'it' : 'them'} include
          the move. It can be a real event, such as a default, or an error in the source data.
        </span>
      </p>
    )
  }

  <div class="fund-grid">
    <div class="fund-main">
      <section class="section">
        <h2 class="section-title">
          Price (NAV)
          <span class="aside" id="range-readout"></span>
        </h2>
        <div class="chart-bar">
          <div class="seg" role="group" aria-label="Time range" id="range-buttons">
            {['1M', '3M', '6M', 'YTD', '1Y', '3Y', '5Y', 'All'].map((range) => (
              <button type="button" data-range={range} aria-pressed={range === '1Y' ? 'true' : 'false'}>{range}</button>
            ))}
          </div>
          {dividends.length > 0 && <span class="chart-legend">NAV only: this fund also pays dividends.</span>}
        </div>
        <div class="chart" id="nav-chart" data-fund-id={id}></div>
        <p class="chart-empty" id="nav-empty" hidden>Not enough NAV history to draw a chart.</p>

        <h3 class="chart-subtitle">Fund size <span class="muted">({currency ? `${currency}, monthly` : 'monthly'})</span></h3>
        <div class="chart" id="aum-chart"></div>
        <p class="chart-empty" id="aum-empty" hidden>No fund size history.</p>
      </section>

      <section class="section" hidden={Object.keys(performance.simplereturn).length === 0}>
        <h2 class="section-title">
          Returns
          {navDate && <span class="aside">to {formatDate(navDate)}</span>}
        </h2>
        <div class="table-scroll">
          <table class="tbl returns-table">
            <thead>
              <tr>
                <th></th>
                {TABLE_PERIODS.map((period) => <th class="num">{PERIOD_LABELS[period]}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Return</th>
                {TABLE_PERIODS.map((period) => <td class={`num ${changeClass(ret(period))}`}>{formatChange(ret(period))}</td>)}
              </tr>
              <tr>
                <th scope="row" title="Compound annual growth rate">Per year</th>
                {TABLE_PERIODS.map((period) => {
                  const value = performance.cagr?.[period] ?? null;

                  return <td class={`num ${changeClass(value)}`}>{formatChange(value)}</td>;
                })}
              </tr>
              <tr>
                <th scope="row" title="Largest fall from a peak within the period">Worst fall</th>
                {TABLE_PERIODS.map((period) => {
                  const value = performance.maxdrawdown?.[period] ?? null;

                  return <td class="num">{formatPercent(value)}</td>;
                })}
              </tr>
            </tbody>
          </table>
        </div>
        {returnsNote && <p class="muted small table-note">{returnsNote} "Per year" is shown for periods of a year or more.</p>}
      </section>

      {
        (assets.length > 0 || latestMix) && (
          <section class="section">
            <h2 class="section-title">Asset mix</h2>
            {assets.length > 0 && (
              <>
                <div class="mix-bar" role="img" aria-label={assets.map((asset) => `${asset.name} ${asset.percentage}%`).join(', ')}>
                  {assets.map((asset) => (
                    <span style={`flex-basis: ${(asset.percentage / assetTotal) * 100}%; background: ${asset.assetClass.color}`} title={`${asset.name}: ${asset.percentage}%`} />
                  ))}
                </div>
                <ul class="mix-legend">
                  {assets.map((asset) => (
                    <li>
                      <i class="key-box" style={`background: ${asset.assetClass.color}`}></i>
                      {asset.name}
                      <span class="num">{formatNumber(asset.percentage, 2)}%</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {latestMix && (
              <figure class="mix-history">
                <figcaption>
                  <span>Mix over the last {mixColumns.length} months <span class="muted">(Bareksa)</span></span>
                  <span class="mix-history-key">
                    {ASSET_CLASSES.map((assetClass) => (
                      <span><i class="key-box" style={`background: ${assetClass.color}`}></i> {assetClass.label}</span>
                    ))}
                  </span>
                </figcaption>
                <svg viewBox={`0 0 ${MIX_WIDTH} ${MIX_HEIGHT}`} preserveAspectRatio="none" role="img" aria-label="Monthly asset mix from Bareksa">
                  {mixColumns.map((column) => (
                    <g>
                      {column.segments.map((segment, index) => (
                        <rect x={column.x} y={segment.y + (index > 0 ? MIX_GAP / 2 : 0)} width={mixColumnWidth} height={Math.max(segment.height - (index > 0 ? MIX_GAP / 2 : 0) - (index < column.segments.length - 1 ? MIX_GAP / 2 : 0), 0.5)} fill={segment.color}>
                          <title>{`${formatMonth(column.date)}: ${ASSET_CLASSES.find((assetClass) => assetClass.key === segment.key).label} ${formatNumber(segment.share * 100, 1)}%`}</title>
                        </rect>
                      ))}
                    </g>
                  ))}
                </svg>
                <div class="mix-axis">
                  <span>{formatMonth(mixColumns[0].date)}</span>
                  <span>{formatMonth(latestMix.date)}</span>
                </div>
              </figure>
            )}
          </section>
        )
      }

      {
        holdings.length > 0 && (
          <section class="section">
            <h2 class="section-title">
              Top holdings
              <span class="aside">{formatDate(holdings[0].date)}, in no order</span>
            </h2>
            <ol class="holdings">
              {holdings.map((holding) => (
                <li>
                  <span>{holding.name}</span>
                  {holding.symbol && holding.symbol !== holding.name && <span class="mono muted">{holding.symbol}</span>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        dividends.length > 0 && (
          <section class="section">
            <h2 class="section-title">
              Dividends
              <span class="aside">{dividends.length} payouts, per unit</span>
            </h2>
            <div class="table-scroll">
              <table class="tbl dividends-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th class="num">Per unit{currency && ` (${currency})`}</th>
                  </tr>
                </thead>
                <tbody>
                  {dividends.slice(0, 12).map((dividend) => (
                    <tr>
                      <td>{formatDate(jakartaDate(dividend.date))}</td>
                      <td class="num">{formatNumber(dividend.value, 4)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {dividends.length > 12 && <p class="muted small table-note">The latest 12 of {dividends.length}. The <a href={`/api/funds/${id}.json`}>fund JSON</a> has all of them.</p>}
          </section>
        )
      }

      {
        fund.profile && (
          <section class="section">
            <h2 class="section-title">
              Profile
              <span class="aside">From the manager, in Indonesian</span>
            </h2>
            <details class="profile">
              <summary>{fund.profile.split('\n')[0].slice(0, 220)}{fund.profile.length > 220 ? '…' : ''}</summary>
              <p>{fund.profile}</p>
            </details>
          </section>
        )
      }
    </div>

    <aside class="fund-side">
      {
        buyLinks.length > 0 && (
          <section class="side-block buy">
            <h2 class="section-title">Buy this fund</h2>
            {buyLinks.map((link) => (
              <div class="buy-row">
                <a class="btn btn-ink" href={link.url} target="_blank" rel="sponsored noopener">Open in {link.name} &nearr;</a>
                <span class="small muted">
                  Referral code <code>{link.code}</code>
                  <button class="copy" type="button" data-copy={link.code} hidden>Copy</button>
                </span>
              </div>
            ))}
            <p class="small muted">New users type the code in the app. It helps keep this site running.</p>
          </section>
        )
      }

      <section class="side-block">
        <h2 class="section-title">Details</h2>
        <dl class="kv">
          {details.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      </section>

      {
        (prospectus.length > 0 || factsheets.length > 0 || makmurDocuments.length > 0) && (
          <section class="side-block">
            <h2 class="section-title">Documents</h2>
            <ul class="doc-list">
              {prospectus.slice(0, 1).map((document) => (
                <li><a href={document.file}>Prospectus</a> <span class="muted small">latest</span></li>
              ))}
              {factsheets.slice(0, 3).map((document) => (
                <li><a href={document.file}>Factsheet</a> <span class="muted small">{document.date ? formatMonth(document.date) : document.name}</span></li>
              ))}
              {makmurDocuments.map(([label, url]) => (
                <li><a href={url}>{label}</a> <span class="muted small">via Makmur</span></li>
              ))}
            </ul>
            {(factsheets.length > 3 || prospectus.length > 1) && (
              <details class="doc-more">
                <summary>{factsheets.length - Math.min(3, factsheets.length) + Math.max(prospectus.length - 1, 0)} older documents</summary>
                <ul class="doc-list">
                  {prospectus.slice(1).map((document) => (
                    <li><a href={document.file}>Prospectus</a> <span class="muted small">{document.name}</span></li>
                  ))}
                  {factsheets.slice(3).map((document) => (
                    <li><a href={document.file}>Factsheet</a> <span class="muted small">{document.date ? formatMonth(document.date) : document.name}</span></li>
                  ))}
                </ul>
              </details>
            )}
          </section>
        )
      }

      {
        switchables.length > 0 && (
          <section class="side-block">
            <h2 class="section-title">Switch to <span class="aside">in Bibit</span></h2>
            <ul class="doc-list">
              {switchables.map((target) => (
                <li><a href={`/funds/${fundIdOfBibitSymbol(target.symbol)}/`}>{target.name}</a></li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="side-block">
        <h2 class="section-title">Data</h2>
        <div class="downloads">
          <a class="btn" href={`/api/funds/${id}.json`} download>JSON</a>
          {history.points.length > 0 && <a class="btn" href={`/csv/nav/${id}.csv`} download>NAV CSV</a>}
          {hasAumHistory && <a class="btn" href={`/csv/aum/${id}.csv`} download>AUM CSV</a>}
        </div>
        <ul class="source-list small">
          {sources.map((source) => (
            <li><a href={source.url}>{source.name}</a> <span class="muted">{source.what} · <span class="mono">{source.ids.join(', ')}</span></span></li>
          ))}
        </ul>
        {
          history.used.length > 0 && (
            <p class="small muted">
              Chart:{' '}
              {history.used.map((part, index) => (
                <>
                  {index > 0 && ', then '}
                  {SOURCE_LABELS[part.source]} from {formatDate(part.from)}
                </>
              ))}
              .{history.droppedSpikes > 0 && ` ${history.droppedSpikes} one-day ${history.droppedSpikes === 1 ? 'spike' : 'spikes'} that reversed the next day ${history.droppedSpikes === 1 ? 'is' : 'are'} left out as source errors.`}
            </p>
          )
        }
      </section>
    </aside>
  </div>
</Base>

<style is:global>
  .crumbs {
    display: flex;
    gap: 6px;
    color: var(--muted);
    font-size: 12.5px;
  }

  .crumbs a {
    color: var(--ink-2);
  }

  .fund-head {
    margin: 6px 0 14px;
  }

  .fund-head .page-title {
    max-width: 30ch;
  }

  .fund-aka {
    margin-top: 4px;
    max-width: 60ch;
  }

  .fund-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-top: 8px;
    color: var(--ink-2);
  }

  .fund-meta .tag {
    margin-right: -6px;
  }

  .notice + .figures,
  .fund-head + .notice {
    margin-top: 14px;
  }

  .figures {
