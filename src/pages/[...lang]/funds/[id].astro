<script>
  // Without JavaScript the code is still shown as text, so the copy buttons stay hidden.
  for (const button of document.querySelectorAll('[data-copy]')) {
    button.hidden = false;

    const label = button.querySelector('.copy-label');
    const original = label.textContent;
    const code = button.parentElement.querySelector('code');

    function showFor(text) {
      label.textContent = text;
      setTimeout(() => {
        label.textContent = original;
      }, 2500);
    }

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy);
        showFor(button.dataset.copied);
      } catch {
        // Clipboard access can be blocked: select the code so the reader can copy it by hand.
        getSelection().selectAllChildren(code);
        showFor(button.dataset.failed);
      }
    });
  }
</script>

<script>
  import { readIncludeDividends, showIncludeDividends, writeIncludeDividends } from '../../../lib/dividend-setting.js';
  import { mountFundCharts, mountMixTooltip } from '../../../lib/fund-charts.js';

  const includeDividends = document.getElementById('include-dividends');

  // The page has a toggle only for a fund with dividends, but the setting is shared, so the charts read it either way.
  if (includeDividends) {
    includeDividends.checked = readIncludeDividends();
    showIncludeDividends(includeDividends.checked);
    includeDividends.addEventListener('change', () => {
      writeIncludeDividends(includeDividends.checked);
      showIncludeDividends(includeDividends.checked);
    });
  }

  const chartCard = document.querySelector('.chart-card');

  if (chartCard) {
    mountFundCharts(chartCard.dataset.fundId, includeDividends);
  }

  const mixHistory = document.querySelector('.mix-history');

  if (mixHistory) {
    mountMixTooltip(mixHistory);
  }
</script>

<script>
  import { MAX_FUNDS, selectionQuery } from '../../../lib/compare.js';
  import { readTray, toggleInTray } from '../../../lib/compare-tray.js';
  import { localizeHref } from '../../../lib/i18n.js';
  import * as m from '../../../paraglide/messages.js';
  import { setLocale } from '../../../paraglide/runtime.js';

  const locale = document.documentElement.lang;

  setLocale(locale, { reload: false });

  const toggle = document.getElementById('compare-toggle');
  const toggleLabel = document.getElementById('compare-toggle-label');
  const open = document.getElementById('compare-open');
  const share = document.getElementById('share-button');
  const status = document.getElementById('action-status');
  let statusTimer = null;

  function sync() {
    const tray = readTray();
    const isCompared = tray.includes(toggle.dataset.fundId);

    toggle.hidden = false;
    toggleLabel.textContent = isCompared ? m.compare_button_remove() : m.compare_button_add();
    toggle.disabled = !isCompared && tray.length >= MAX_FUNDS;
    toggle.title = toggle.disabled ? m.compare_full({ count: MAX_FUNDS }) : '';
    open.hidden = tray.length === 0;
    open.textContent = m.compare_open({ count: tray.length });
    open.href = localizeHref(`/compare/${selectionQuery(tray)}`, locale);
  }

  function say(text) {
    status.textContent = text;
    clearTimeout(statusTimer);
    statusTimer = setTimeout(() => {
      status.textContent = '';
    }, 3000);
  }

  toggle.addEventListener('click', () => {
    toggleInTray(toggle.dataset.fundId);
    sync();
  });

  share.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url: location.href });

        return;
      } catch (error) {
        if (error.name === 'AbortError') {
          return;
        }
      }
    }

    try {
      await navigator.clipboard.writeText(location.href);
      say(m.fund_share_copied());
    } catch {
      say(m.fund_share_failed());
    }
  });

  sync();
</script>

<script>
  import { mountInfoPopovers } from '../../../lib/info-popover.js';

  mountInfoPopovers();

  // The section nav marks the section being read, and fades at the edge where it scrolls on a phone.
  const nav = document.querySelector('.section-nav');
  const list = nav.querySelector('.section-nav-list');
  const links = [...nav.querySelectorAll('a')];
  const sections = links.map((link) => document.getElementById(link.hash.slice(1)));
  const FADE_WIDTH = 28;
  const READING_LINE = 140;
  let frame = null;

  function markCurrent() {
    frame = null;

    let current = 0;

    sections.forEach((section, index) => {
      if (section.getBoundingClientRect().top <= READING_LINE) {
        current = index;
      }
    });

    // At the bottom of the page the last section may be too short to reach the reading line.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      current = sections.length - 1;
    }

    links.forEach((link, index) => {
      if (index === current) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    const link = links[current];

    list.scrollTo({ left: link.offsetLeft - (list.clientWidth - link.offsetWidth) / 2, behavior: 'auto' });
  }

  function showFades() {
    const atStart = list.scrollLeft <= 1;
    const atEnd = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;

    nav.style.setProperty('--fade-start', atStart ? '0px' : `${FADE_WIDTH}px`);
    nav.style.setProperty('--fade-end', atEnd ? '0px' : `${FADE_WIDTH}px`);
  }

  function schedule() {
    frame ??= requestAnimationFrame(markCurrent);
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', () => {
    schedule();
    showFades();
  });
  list.addEventListener('scroll', showFades, { passive: true });
  markCurrent();
  showFades();
</script>
