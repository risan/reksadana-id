---
import Base from '../../../layouts/Base.astro';
import { fundBenchmarks, fundIdOfBibitSymbol, fundPerformance, isActive, latestAum, latestNavDate, listFundIds, loadBenchmarks, loadFundRecord, loadFundSummaries, shortManagerName, staleSourceDate } from '../../../lib/data.js';
import { describeCosts } from '../../../lib/costs-text.js';
import { explorerTypeKey } from '../../../lib/explorer.js';
import { changeClass, formatChange, formatDate, formatMoney, formatMonth, formatNav, formatNumber, formatPercent } from '../../../lib/format.js';
import { TABLE_PERIODS, linePath, medianReturns, peerReturns, profileSummary, shareBeaten, shortBenchmarkName } from '../../../lib/fund-page.js';
import { shariaText, typeLook, typeName } from '../../../lib/fund-types.js';
import { localePaths, localizeHref } from '../../../lib/i18n.js';
import { icon } from '../../../lib/icons.js';
import { REFERRALS, bibitFundUrl } from '../../../lib/referrals.js';
import * as m from '../../../paraglide/messages.js';
import { SOURCE_LABELS, daysBetween, fundCurrency, jakartaDate, largeMoves, pickAumHistory, pickNavHistory } from '../../../lib/series.js';

export function getStaticPaths() {
  return localePaths(listFundIds().map((id) => ({ id })));
}

const { id } = Astro.params;
const locale = Astro.currentLocale ?? 'id';
const href = (path) => localizeHref(path, locale);
const sourceLabel = (source) => (source === 'bareksa-monthly' ? m.source_bareksa_monthly() : SOURCE_LABELS[source]);
const fund = loadFundRecord(id);
const info = fund.fund;
const { kontan, bareksa, makmur } = fund;
const hasBibit = info.sources.bibit.length > 0;

const history = pickNavHistory(fund);
const performance = fundPerformance(fund, history);
const lastPoint = history.points.at(-1);
const navValue = lastPoint?.value ?? null;
const navDate = history.frozenSince ?? lastPoint?.date ?? null;
const active = isActive(navDate, lastPoint?.source);
const sourceDataDate = staleSourceDate(lastPoint?.source);
// A source that refreshes daily is never worth a notice; one that trails the site's newest data by days is.
const STALE_SOURCE_DAYS = 5;
const isSourceBehind = sourceDataDate !== null && daysBetween(sourceDataDate, latestNavDate()) > STALE_SOURCE_DAYS;
const currency = fundCurrency(fund);
const aum = latestAum(fund);
const aumPoints = pickAumHistory(fund).points;
const hasNavChart = history.points.length >= 2;
const hasAumChart = aumPoints.length >= 2;
const aumCurrency = aumPoints.at(-1)?.currency ?? null;
const moves = largeMoves(history.points).reverse();

const PERIOD_LABELS = {
  '1d': m.period_1d(),
  '1m': m.period_1m(),
  '3m': m.period_3m(),
  '6m': m.period_6m(),
  ytd: m.period_ytd(),
  '1y': m.period_1y(),
  '3y': m.period_3y(),
  '5y': m.period_5y(),
  '10y': m.period_10y(),
  all: m.period_all(),
};
const ret = (period, returns = performance) => returns?.simplereturn?.[period] ?? null;
const total = performance.total;

// Document URLs come from scraped data, so never link anything but http(s), such as a javascript: URL.
function isWebUrl(url) {
  return typeof url === 'string' && /^https?:\/\//i.test(url);
}

const ASSET_CLASSES = [
  { key: 'equity', label: m.asset_equity(), color: 'var(--alloc-equity)', pattern: /saham|ekuitas|equit|stock/i },
  { key: 'bonds', label: m.asset_bonds(), color: 'var(--alloc-bonds)', pattern: /obligasi|sukuk|utang|hutang|pendapatan tetap|fixed income|bond/i },
  { key: 'money', label: m.asset_money(), color: 'var(--alloc-money)', pattern: /pasar uang|deposit|kas|cash|money|likuid|setara/i },
  { key: 'other', label: m.asset_other(), color: 'var(--alloc-other)', pattern: /.*/ },
];

function assetClassOf(name) {
  return ASSET_CLASSES.find((assetClass) => assetClass.pattern.test(name));
}

// Bibit's mix uses the manager's own names; the bar groups them into four classes, the list keeps the names.
const assets = (fund.asset ?? [])
  .filter((asset) => asset.percentage > 0)
  .map((asset) => ({ ...asset, assetClass: assetClassOf(asset.name) }))
  .sort((a, b) => ASSET_CLASSES.indexOf(a.assetClass) - ASSET_CLASSES.indexOf(b.assetClass) || b.percentage - a.percentage);

// The English page names a bare Indonesian class word ("Obligasi", "Lainnya") with the class label; longer names stay as given.
const INDONESIAN_CLASS_WORDS = /^(saham|obligasi|sukuk|pasar uang|deposito|kas|lainnya)$/i;
const assetName = (asset) => (locale === 'en' && INDONESIAN_CLASS_WORDS.test(asset.name.trim()) ? asset.assetClass.label : asset.name);
const assetTotal = assets.reduce((sum, asset) => sum + asset.percentage, 0);

const BAREKSA_CLASSES = [
  ['saham', 'equity'],
  ['obligasi', 'bonds'],
  ['pasar_uang', 'money'],
  ['lainnya', 'other'],
];
const ALLOCATION_MONTHS = 24;
const allocationHistory = (bareksa?.allocation ?? [])
  .filter((row) => BAREKSA_CLASSES.some(([column]) => row[column] > 0))
  .slice(-ALLOCATION_MONTHS);

const MIX_WIDTH = 600;
const MIX_HEIGHT = 120;
const MIX_GAP = 2;
const mixColumnWidth = allocationHistory.length ? (MIX_WIDTH - MIX_GAP * (allocationHistory.length - 1)) / allocationHistory.length : 0;
const mixColumns = allocationHistory.map((row, index) => {
  const total = BAREKSA_CLASSES.reduce((sum, [column]) => sum + (row[column] ?? 0), 0);
  let y = MIX_HEIGHT;

  const segments = BAREKSA_CLASSES.map(([column, key]) => {
    const share = (row[column] ?? 0) / total;
    const height = share * MIX_HEIGHT;

    y -= height;

    return { key, share, y, height, color: ASSET_CLASSES.find((assetClass) => assetClass.key === key).color };
  }).filter((segment) => segment.height > 0);

  return { date: row.date, x: index * (mixColumnWidth + MIX_GAP), segments };
});
const latestMix = mixColumns.at(-1);

const holdings = fund.holding ?? [];
const dividends = [...(fund.dividends ?? [])].sort((a, b) => b.date.localeCompare(a.date));
const factsheets = [...(fund.documents?.factsheets ?? [])].filter((document) => isWebUrl(document.file)).sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const prospectus = [...(fund.documents?.prospectus ?? [])].filter((document) => isWebUrl(document.file)).reverse();
const olderDocumentCount = factsheets.length - Math.min(3, factsheets.length) + Math.max(prospectus.length - 1, 0);
const makmurDocuments = [
  [m.doc_prospectus(), makmur?.data.prospectus],
  [m.doc_factsheet(), makmur?.data.factsheet],
].filter(([, url]) => isWebUrl(url));
const hasDocuments = prospectus.length > 0 || factsheets.length > 0 || makmurDocuments.length > 0;
const switchables = fund.switchables ?? [];
const buyLinks = [
  fund.tradeable && { ...REFERRALS.bibit, url: bibitFundUrl(fund.symbol) },
  makmur && { ...REFERRALS.makmur, url: makmur.url },
].filter(Boolean);

const typeLabel = info.type ? typeName(info.type, locale) : null;
const look = typeLook(info.type);
// English pages keep Bibit's own label beside the English name, so a reader can match it to the apps.
const typeNote = typeLabel !== null && typeLabel !== info.type ? info.type : null;
const launchDate = info.launch_date ?? fund.released_date ?? null;
const manager = shortManagerName(info.manager);
const RISK_LEVELS = { Low: m.risk_low(), Moderate: m.risk_moderate(), High: m.risk_high() };
const riskProfile = Object.hasOwn(RISK_LEVELS, fund.riskprofile) ? RISK_LEVELS[fund.riskprofile] : null;
const returnsNote = (isTotal) =>
  [
    isTotal ? m.returns_note_total({ source: sourceLabel(history.primary) }) : m.returns_note({ source: sourceLabel(history.primary) }),
    !isTotal && dividends.length > 0 && m.returns_note_dividends(),
    m.returns_note_per_year(),
  ]
    .filter(Boolean)
    .join(' ');

const benchmarkMetadata = new Map(loadBenchmarks().map((series) => [series.id, series]));
const benchmarks = fundBenchmarks(info, history).map((benchmark) => {
  const name = benchmarkMetadata.get(benchmark.id).name[locale];

  return { ...benchmark, name, shortName: shortBenchmarkName(name) };
});
const indexBenchmarks = benchmarks.filter((benchmark) => benchmark.returns !== null);
const rateBenchmark = benchmarks.find((benchmark) => benchmark.returns === null);

const ojk = fund.ojk;
const ojkLatest = ojk?.months.at(-1) ?? null;
const ojkMonth = ojkLatest ? formatMonth(`${ojkLatest.month}-01`, locale) : null;
const ojkSparkPath = ojk && ojk.months.some((month) => month.aum > 0) ? linePath(ojk.months.map((month) => month.aum), 200, 36) : null;

function ojkDetails() {
  if (!ojk) {
    return [];
  }

  if (ojk.status === 'registered') {
    return [
      [m.detail_ojk(), m.ojk_registered()],
      [m.detail_ojk_aum(), `${formatMoney(ojkLatest.aum, locale, 'IDR')} · ${ojkMonth}`],
    ];
  }

  if (ojk.status === 'zero_aum') {
    return [[m.detail_ojk(), m.ojk_zero_row({ month: ojkMonth })]];
  }

  return [[m.detail_ojk(), m.ojk_not_listed({ month: ojkMonth }), true]];
}

const details = [
  [m.detail_type(), typeLabel === null ? null : `${typeLabel}${typeNote ? ` (${typeNote})` : ''}`],
  [m.detail_manager(), info.manager],
  [m.detail_currency(), currency ?? m.detail_not_stated()],
  [m.compare_row_sharia(), shariaText(info.sharia)],
  [m.detail_launched(), launchDate ? formatDate(launchDate, locale) : null],
  [m.detail_risk(), riskProfile],
  ...ojkDetails(),
].filter(([, value]) => value !== null && value !== undefined && value !== '');

function threeYearSub(returns) {
  const threeYearsPerYear = returns.cagr?.['3y'] ?? null;

  if (threeYearsPerYear !== null) {
    return m.figure_three_year_sub({ change: formatChange(threeYearsPerYear, locale) });
  }

  return ret('ytd', returns) === null ? '' : m.figure_ytd_sub({ change: formatChange(ret('ytd', returns), locale) });
}

const returnFigure = (returns, label) => ({ label, value: formatChange(ret('1y', returns), locale), className: changeClass(ret('1y', returns)), sub: threeYearSub(returns) });
const worstFallFigure = (returns, label) => ({ label, value: formatPercent(returns.maxdrawdown?.['1y'] ?? null, locale), sub: m.figure_worst_fall_sub() });

const navFigure = (returns) => ({
  label: active ? m.figure_nav() : m.figure_last_nav(),
  value: navValue === null ? '—' : formatNav(navValue, locale),
  unit: currency,
  sub: navDate ? formatDate(navDate, locale) : m.figure_no_nav(),
  change: active ? ret('1d', returns) : null,
});

const figures = [
  { key: 'nav', info: m.info_nav(), ...navFigure(performance), total: total && navFigure(total) },
  { key: 'return', info: m.info_return(), ...returnFigure(performance, m.figure_return_1y()), total: total && returnFigure(total, m.figure_return_1y_total()) },
  { key: 'fall', info: m.info_drawdown(), ...worstFallFigure(performance, m.figure_worst_fall()), total: total && worstFallFigure(total, m.figure_worst_fall_total()) },
  { key: 'aum', info: m.info_aum(), label: m.figure_aum(), value: formatMoney(aum?.value ?? null, locale, aum?.currency), sub: aum ? formatMonth(aum.date, locale) : '' },
].filter((figure, index) => index === 0 || figure.value !== '—');

// A figure with dividends included has two views, which the page switches between.
const figureViews = (figure) => (figure.total ? [{ view: 'nav', ...figure }, { view: 'total', ...figure.total }] : [figure]);

const summaries = loadFundSummaries().funds;
const peers = info.type ? peerReturns(summaries).get(info.type) : undefined;
const ownSummary = summaries.find((summary) => summary.id === id);
const ownOneYear = ownSummary?.return_1y ?? null;
const shareBeatenOneYear = active && peers && ownOneYear !== null ? shareBeaten(peers.nav['1y'], ownOneYear) : null;

const costs = describeCosts(fund.costs, locale);
const feeRows = costs.fees.length === 0 ? [[m.compare_row_max_fees(), []]] : costs.fees.map((fee) => [fee.label, [fee]]);
const listOf = (value) => (value === null ? [] : [value]);
const costRows = [
  [m.compare_row_min_purchase(), costs.minPurchases],
  [m.cost_row_min_topup(), listOf(costs.minTopup)],
  [m.cost_row_min_redemption(), listOf(costs.minRedemption)],
  ...feeRows,
  [m.detail_custodian(), listOf(costs.custodian)],
];
const costRowsWithData = costRows.filter(([, values]) => values.length > 0);
const missingCosts = [...(costs.expenseRatios.length === 0 ? [m.detail_expense_ratio()] : []), ...costRows.filter(([, values]) => values.length === 0).map(([label]) => label)];
const hasCosts = costs.operatingExpense !== null || costs.expenseRatios.length > 0 || costRowsWithData.length > 0;

const glance = [];
const oneYear = ret('1y');

if (active && oneYear !== null) {
  const change = formatPercent(Math.abs(oneYear), locale, 1);
  const sentence = oneYear >= 0 ? m.glance_return_up({ change }) : m.glance_return_down({ change });
  const rank =
    shareBeatenOneYear === null
      ? null
      : shareBeatenOneYear >= 0.5
        ? m.glance_rank_ahead({ percent: formatPercent(shareBeatenOneYear, locale, 0), type: typeLabel })
        : m.glance_rank_behind({ percent: formatPercent(1 - shareBeatenOneYear, locale, 0), type: typeLabel });

  glance.push([sentence, rank].filter(Boolean).join(' '));
}

const indexOneYear = indexBenchmarks[0]?.returns.simplereturn?.['1y'] ?? null;

if (active && oneYear !== null && indexOneYear !== null) {
  glance.push(m.glance_benchmark({ name: indexBenchmarks[0].shortName, change: formatChange(indexOneYear, locale, 1) }));
}

const oneYearFall = performance.maxdrawdown?.['1y'] ?? null;

if (active && oneYear !== null && oneYearFall !== null && oneYearFall < 0) {
  glance.push(m.glance_drawdown({ drop: formatPercent(Math.abs(oneYearFall), locale, 1) }));
}

if (costs.expenseRatios.length > 0) {
  glance.push(m.glance_costs({ value: costs.expenseRatios.map((item) => `${item.text} (${item.source})`).join(', ') }));
}

const historyYears = hasNavChart ? Math.floor(daysBetween(history.points[0].date, lastPoint.date) / 365.25) : 0;

if (historyYears >= 1) {
  glance.push(historyYears === 1 ? m.glance_history_one() : m.glance_history({ count: historyYears }));
}

const summary = profileSummary(fund.profile);
const profileText = fund.profile?.trim();

const returnPeriods = TABLE_PERIODS.filter((period) =>
  [ret(period), performance.cagr?.[period], performance.maxdrawdown?.[period]].some((value) => value !== null && value !== undefined),
);
const medians = { nav: medianReturns(peers?.nav), total: medianReturns(peers?.total) };
// The medians are of funds that report today, which says nothing about a fund that stopped.
const hasMedians = active && Object.values(medians.nav).some((value) => value !== null);

// Every row of the returns table comes from here; a row for another yardstick is one more entry in the list.
// The rows after the fund's own are yardsticks: muted, with no gain or loss color.
function returnRows(returns, medianOfType) {
  const percentCell = (value) => ({ text: formatPercent(value, locale), className: '' });
  const changeCell = (value) => ({ text: formatChange(value, locale), className: changeClass(value) });

  return [
    { label: m.returns_row_return(), cells: returnPeriods.map((period) => changeCell(ret(period, returns))) },
    { label: m.returns_row_per_year(), title: m.returns_row_per_year_title(), cells: returnPeriods.map((period) => changeCell(returns.cagr?.[period] ?? null)) },
    { label: m.returns_row_worst_fall(), title: m.returns_row_worst_fall_title(), cells: returnPeriods.map((period) => percentCell(returns.maxdrawdown?.[period] ?? null)) },
    hasMedians && { label: m.returns_row_median({ type: typeLabel }), className: 'row-reference', cells: returnPeriods.map((period) => ({ text: formatChange(medianOfType[period], locale), className: '' })) },
    ...indexBenchmarks.map((benchmark) => ({
      label: benchmark.shortName,
      title: benchmark.name,
      className: 'row-reference',
      cells: returnPeriods.map((period) => ({ text: formatChange(benchmark.returns.simplereturn?.[period] ?? null, locale), className: '' })),
    })),
  ].filter(Boolean);
}

const returnViews = [{ view: 'nav', rows: returnRows(performance, medians.nav) }, ...(total ? [{ view: 'total', rows: returnRows(total, medians.total) }] : [])];

const showPerformance = hasNavChart || hasAumChart;
const showPortfolio = assets.length > 0 || latestMix !== undefined || holdings.length > 0;
const sectionLinks = [
  ['overview', m.section_overview(), true],
  ['performance', m.section_performance(), showPerformance],
  ['portfolio', m.section_portfolio(), showPortfolio],
  ['costs', m.section_costs(), hasCosts],
  ['documents', m.documents_title(), hasDocuments || switchables.length > 0],
  ['data', m.data_title(), true],
].filter(([, , isShown]) => isShown);

const sources = [
  hasBibit && { name: 'Bibit', url: 'https://app.bibit.id/', what: m.source_bibit(), ids: info.sources.bibit },
  kontan && { name: 'Kontan', url: `https://pusatdata.kontan.co.id/reksadana/produk/${kontan.id}`, what: m.source_kontan(), ids: info.sources.kontan },
  bareksa && { name: 'Bareksa', url: `https://www.bareksa.com/id/data/reksadana/${bareksa.id}/`, what: m.source_bareksa(), ids: info.sources.bareksa },
  makmur && { name: 'Makmur', url: makmur.url, what: m.source_makmur(), ids: info.sources.makmur },
].filter(Boolean);
---

<Base title={`${info.name} (${id})`} description={manager ? m.fund_description({ name: info.name, manager }) : m.fund_description_no_manager({ name: info.name })} section="funds">
  <header class="fund-hero card kawung-bg">
    <nav class="crumbs" aria-label={m.crumbs_label()}>
      <a href={href('/')}>{m.nav_funds()}</a>
      {info.type && <><Fragment set:html={icon('chevron-right', { size: 14 })} /><a href={href(`/?type=${encodeURIComponent(explorerTypeKey(info.type))}`)}>{typeLabel}</a></>}
      <Fragment set:html={icon('chevron-right', { size: 14 })} /><span class="mono">{id}</span>
    </nav>
    <div class="fund-hero-main">
      <span class={`icon-tile fund-tile type-${look.tone}`} set:html={icon(look.icon, { size: 28 })} />
      <div class="fund-titles">
        <h1 class="page-title">{info.name}</h1>
        {info.other_names.length > 0 && <p class="fund-aka muted small">{m.fund_also_known_as()} {info.other_names.join(' · ')}</p>}
        {
          manager && (
            <p class="fund-manager">
              <a href={href(`/?manager=${encodeURIComponent(manager)}`)} title={m.fund_manager_link({ manager })}>{manager}</a>
            </p>
          )
        }
        <ul class="fund-chips">
          {info.type && <li><a class={`tag tag-type type-${look.tone}`} href={href(`/?type=${encodeURIComponent(explorerTypeKey(info.type))}`)}><Fragment set:html={icon(look.icon, { size: 14 })} />{typeLabel}{typeNote && <span class="chip-note">{typeNote}</span>}</a></li>}
          {info.sharia ? <li><span class="tag"><Fragment set:html={icon('moon-star', { size: 14 })} />{m.tag_sharia()}</span></li> : null}
          {currency === 'USD' && <li><span class="tag">USD</span></li>}
          {info.etf ? <li><span class="tag">ETF</span></li> : null}
          {info.index ? <li><span class="tag">{m.tag_index()}</span></li> : null}
          {dividends.length > 0 && <li><span class="tag"><Fragment set:html={icon('coins', { size: 14 })} />{m.tag_pays_dividends()}</span></li>}
          {riskProfile && <li><span class="tag">{m.tag_risk({ level: riskProfile })}</span></li>}
        </ul>
      </div>
    </div>
    <div class="fund-actions">
      <button class="btn" type="button" id="compare-toggle" data-fund-id={id} hidden><Fragment set:html={icon('git-compare')} /><span id="compare-toggle-label"></span></button>
      <a class="btn btn-primary" id="compare-open" href={href('/compare/')} hidden></a>
      <button class="btn" type="button" id="share-button"><Fragment set:html={icon('share-2')} />{m.fund_share()}</button>
      {buyLinks.length > 0 && <a class="btn btn-primary fund-buy-jump" href="#buy">{m.fund_buy_jump()}</a>}
      <span class="action-status small muted" id="action-status" role="status"></span>
    </div>
  </header>

  {
    !active && (
      <p class="notice fund-notice">
        <Fragment set:html={icon('info')} />
        <span>
          <strong>{m.inactive_title()}</strong>{' '}
          {history.frozenSince
            ? m.inactive_frozen({ date: formatDate(navDate, locale) })
            : navDate
              ? m.inactive_since({ date: formatDate(navDate, locale) })
              : m.inactive_no_nav()}{' '}
          {m.inactive_reason()}
        </span>
      </p>
    )
  }

  {
    isSourceBehind && (
      <p class="notice fund-notice">
        <Fragment set:html={icon('calendar')} />
        <span>{m.data_freshness({ source: sourceLabel(lastPoint.source), date: formatDate(sourceDataDate, locale) })}</span>
      </p>
    )
  }

  {
    ojk?.status === 'zero_aum' && (
      <p class="notice fund-notice">
        <Fragment set:html={icon('info')} />
        <span>{m.ojk_zero_notice({ month: ojkMonth })}</span>
      </p>
    )
  }

  <nav class="section-nav" aria-label={m.section_nav_label()}>
    <ul class="section-nav-list">
      {sectionLinks.map(([key, label]) => <li><a href={`#${key}`}>{label}</a></li>)}
    </ul>
  </nav>

  <div class="fund-body">
  <div class="fund-main">
  <section class="fund-section" id="overview">
    <dl class="figures">
      {figures.map((figure) => (
        <div class="figure">
          <dt>
            <span class="figure-label">{figureViews(figure).map((shown) => <span data-view={shown.view}>{shown.label}</span>)}</span>
            <button class="info-btn" type="button" popovertarget={`info-${figure.key}`} aria-label={m.info_about({ term: figure.label })}><Fragment set:html={icon('info', { size: 16 })} /></button>
          </dt>
          <dd class="figure-value">{figureViews(figure).map((shown) => <span data-view={shown.view} class={shown.className ?? ''}>{shown.value}{shown.unit && shown.value !== '—' && <span class="unit">{shown.unit}</span>}</span>)}</dd>
          <dd class="figure-sub">
            {
              figureViews(figure).map((shown) => (
                <span data-view={shown.view}>
                  {shown.sub}
                  {shown.change !== null && shown.change !== undefined && <span class={changeClass(shown.change)}> · {m.figure_one_day({ change: formatChange(shown.change, locale) })}</span>}
                </span>
              ))
            }
          </dd>
        </div>
      ))}
    </dl>
    {figures.map((figure) => <div class="info-pop" id={`info-${figure.key}`} popover>{figure.info}</div>)}

    {
      total && (
        <label class="dividend-toggle">
          <input type="checkbox" id="include-dividends" /> {m.dividends_toggle()}
          <span class="muted small">{m.dividends_toggle_here()}</span>
        </label>
      )
    }

    {
      moves.length > 0 && (
        <p class="notice fund-notice">
          <Fragment set:html={icon('info')} />
          <span>
            <strong>{moves.length === 1 ? m.moves_title_one() : m.moves_title_many()}</strong>{' '}
            {moves.slice(0, 3).map((move, index) => (
              <>
                {index > 0 && '; '}
                {m.moves_item({ change: formatChange(move.change, locale, 1), date: formatDate(move.date, locale) })}
              </>
            ))}
            {moves.length > 3 && `; ${m.moves_more({ count: moves.length - 3 })}`}. {moves.length === 1 ? m.moves_note_one() : m.moves_note_many()}
          </span>
        </p>
      )
    }
  </section>

  {
    glance.length > 0 && (
      <section class="card glance">
        <h2 class="card-title">{m.glance_title()}</h2>
        <ul class="glance-list">
          {glance.map((sentence) => <li>{sentence}</li>)}
        </ul>
      </section>
    )
  }

  {
    summary !== null && (
      <section class="card profile-card">
        <h2 class="card-title">{m.profile_title()} <span class="aside muted">{m.profile_aside()}</span></h2>
        {
          profileText === summary ? (
            <p class="profile-text">{summary}</p>
          ) : (
            <details class="profile">
              <summary>{summary}</summary>
              <p class="profile-text">{profileText}</p>
            </details>
          )
        }
      </section>
    )
  }

  {
    showPerformance && (
      <section class="fund-section" id="performance">
        <h2 class="section-title">{m.section_performance()}</h2>
        <div class="card chart-card" data-fund-id={id} data-benchmarks={JSON.stringify(indexBenchmarks.map(({ id: benchmarkId, shortName, name }) => ({ id: benchmarkId, shortName, name })))}>
          {
            hasNavChart && (
              <>
                <div class="chart-head">
                  <h3 class="card-title">{m.chart_nav_title()}</h3>
                  <span id="range-readout"></span>
                </div>
                <div class="chart-bar">
                  <div class="seg" role="group" aria-label={m.chart_range_label()} id="range-buttons">
                    {[['1M', '1m'], ['3M', '3m'], ['6M', '6m'], ['YTD', 'ytd'], ['1Y', '1y'], ['3Y', '3y'], ['5Y', '5y'], ['All', 'all']].map(([range, period]) => (
                      <button type="button" data-range={range} aria-pressed={range === '1Y' ? 'true' : 'false'}>{PERIOD_LABELS[period]}</button>
                    ))}
                  </div>
                  {
                    dividends.length > 0 && (
                      <span class="chart-legend small">
                        {total ? <span data-view="nav">{m.chart_nav_only()}</span> : m.chart_nav_only()}
                        {total && <span data-view="total">{m.chart_total()}</span>}
                      </span>
                    )
                  }
                </div>
                {
                  indexBenchmarks.length > 0 && (
                    <div class="chart-bar">
                      <span class="small muted" id="benchmark-label">{m.chart_compare_with()}</span>
                      <div class="seg" role="group" aria-labelledby="benchmark-label" id="benchmark-buttons">
                        <button type="button" data-benchmark="" aria-pressed="true">{m.chart_compare_none()}</button>
                        {indexBenchmarks.map((benchmark) => <button type="button" data-benchmark={benchmark.id} title={benchmark.name} aria-pressed="false">{benchmark.shortName}</button>)}
                      </div>
                    </div>
                  )
                }
                <div class="chart" id="nav-chart"></div>
                <p class="chart-empty" id="benchmark-error" hidden></p>
              </>
            )
          }
          {
            hasAumChart && (
              <>
                <h3 class="card-title chart-subtitle">{m.figure_aum()} <span class="muted">({aumCurrency ? m.chart_aum_currency_monthly({ currency: aumCurrency }) : m.chart_aum_monthly()})</span></h3>
                <div class="chart" id="aum-chart"></div>
              </>
            )
          }
          <p class="chart-empty" id="chart-error" hidden></p>
        </div>

        {
          returnPeriods.length > 0 && (
            <>
            <h3 class="card-title block-title">
              {m.returns_title()}
              {navDate && <span class="aside muted">{m.returns_to({ date: formatDate(navDate, locale) })}</span>}
            </h3>
            <div class="table-scroll">
              <table class="tbl returns-table">
                <thead>
                  <tr>
                    <th></th>
                    {returnPeriods.map((period) => <th class="num">{PERIOD_LABELS[period]}</th>)}
                  </tr>
                </thead>
                {returnViews.map(({ view, rows }) => (
                  <tbody data-view={total ? view : undefined}>
                    {rows.map((row) => (
                      <tr class={row.className}>
                        <th scope="row" title={row.title}>{row.label}</th>
                        {row.cells.map((cell) => <td class={`num ${cell.className}`}>{cell.text}</td>)}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
            {
              rateBenchmark && (
                <p class="muted small table-note">{m.benchmark_rate_note({ name: rateBenchmark.shortName, rate: `${formatNumber(rateBenchmark.value, locale, 2, 2)}%`, date: formatDate(rateBenchmark.end_date, locale) })}</p>
              )
            }
            {
              performance.source && (
                <p class="muted small table-note">
                  {total ? <span data-view="nav">{returnsNote(false)}</span> : returnsNote(false)}
                  {total && <span data-view="total">{returnsNote(true)}</span>}
                </p>
              )
            }
            </>
          )
        }

        {
          dividends.length > 0 && (
            <>
              <h3 class="card-title block-title">
                {m.dividends_title()}
                <span class="aside muted">{dividends.length === 1 ? m.dividends_aside_one() : m.dividends_aside({ count: dividends.length })}</span>
              </h3>
              <div class="table-scroll dividends-scroll">
                <table class="tbl dividends-table">
                  <thead>
                    <tr>
                      <th>{m.dividends_date()}</th>
                      <th class="num">{m.dividends_per_unit()}{currency && ` (${currency})`}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {dividends.map((dividend) => (
                      <tr>
                        <td>{formatDate(jakartaDate(dividend.date), locale)}</td>
                        <td class="num">{formatNumber(dividend.value, locale, 4)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )
        }
      </section>
    )
  }

  {
    showPortfolio && (
      <section class="fund-section" id="portfolio">
        <h2 class="section-title">{m.section_portfolio()}</h2>
        <div class="portfolio-grid">
          {
            (assets.length > 0 || latestMix) && (
              <div class="card mix-card">
                <h3 class="card-title">{m.asset_mix_title()}</h3>
                {assets.length > 0 && (
                  <>
                    <div class="mix-bar" role="img" aria-label={assets.map((asset) => `${assetName(asset)} ${asset.percentage}%`).join(', ')}>
                      {assets.map((asset) => (
                        <span style={`flex-basis: ${(asset.percentage / assetTotal) * 100}%; background: ${asset.assetClass.color}`} title={`${assetName(asset)}: ${asset.percentage}%`} />
                      ))}
                    </div>
                    <ul class="mix-legend">
                      {assets.map((asset) => (
                        <li>
                          <i class="key-box" style={`background: ${asset.assetClass.color}`}></i>
                          {assetName(asset)}
                          <span class="num">{formatNumber(asset.percentage, locale, 2, 2)}%</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {latestMix && (
                  <figure class="mix-history">
                    <figcaption>
                      <span>{mixColumns.length === 1 ? m.asset_mix_history_one() : m.asset_mix_history({ count: mixColumns.length })} <span class="muted">(Bareksa)</span></span>
                      <span class="mix-history-key">
                        {ASSET_CLASSES.map((assetClass) => (
                          <span><i class="key-box" style={`background: ${assetClass.color}`}></i> {assetClass.label}</span>
                        ))}
                      </span>
                    </figcaption>
                    <svg viewBox={`0 0 ${MIX_WIDTH} ${MIX_HEIGHT}`} preserveAspectRatio="none" role="img" aria-label={m.asset_mix_history_label()}>
                      {mixColumns.map((column) => (
                        <g>
                          {column.segments.map((segment, index) => (
                            <rect x={column.x} y={segment.y + (index > 0 ? MIX_GAP / 2 : 0)} width={mixColumnWidth} height={Math.max(segment.height - (index > 0 ? MIX_GAP / 2 : 0) - (index < column.segments.length - 1 ? MIX_GAP / 2 : 0), 0.5)} fill={segment.color}>
                              <title>{`${formatMonth(column.date, locale)}: ${ASSET_CLASSES.find((assetClass) => assetClass.key === segment.key).label} ${formatNumber(segment.share * 100, locale, 1)}%`}</title>
                            </rect>
                          ))}
                        </g>
                      ))}
                    </svg>
                    <div class="mix-axis">
                      <span>{formatMonth(mixColumns[0].date, locale)}</span>
                      <span>{formatMonth(latestMix.date, locale)}</span>
                    </div>
                  </figure>
                )}
              </div>
            )
          }

          {
            holdings.length > 0 && (
              <div class="card holdings-card">
                <h3 class="card-title">
                  {m.holdings_title()}
                  <span class="aside muted">{m.holdings_aside({ date: formatDate(holdings[0].date, locale) })}</span>
                </h3>
                <ul class="holdings">
                  {holdings.map((holding) => (
                    <li>
                      <span>{holding.name}</span>
                      {holding.symbol && holding.symbol !== holding.name && <span class="mono muted">{holding.symbol}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>
    )
  }

  {
    hasCosts && (
      <section class="fund-section" id="costs">
        <h2 class="section-title">{m.compare_group_costs()}</h2>
        <div class="card costs-card">
          {
            costs.operatingExpense && (
              <div class="expense audited">
                <h3 class="card-title">
                  {m.detail_operating_expense()}
                  <button class="info-btn" type="button" popovertarget="info-operating-expense" aria-label={m.info_about({ term: m.detail_operating_expense() })}><Fragment set:html={icon('info', { size: 16 })} /></button>
                </h3>
                <ul class="expense-list">
                  <li><span class="expense-value">{costs.operatingExpense.text}</span><span class="muted small">{m.cost_operating_expense_year({ year: costs.operatingExpense.year })}</span></li>
                </ul>
                <p class="small"><a href={costs.operatingExpense.url}>{costs.operatingExpense.provider === 'manager' ? m.cost_operating_expense_link_manager() : m.cost_operating_expense_link()}</a></p>
                <div class="info-pop" id="info-operating-expense" popover>{m.cost_operating_expense_info()}</div>
              </div>
            )
          }
          {
            costs.expenseRatios.length > 0 && (
              <div class="expense">
                <h3 class="card-title">{m.detail_expense_ratio()}</h3>
                <ul class="expense-list">
                  {costs.expenseRatios.map((item) => (
                    <li><span class="expense-value">{item.text}</span><span class="muted small">{item.source}</span></li>
                  ))}
                </ul>
                {costs.expenseRatios.length > 1 && <p class="small muted">{m.cost_sources_differ()}</p>}
              </div>
            )
          }
          {
            costRowsWithData.length > 0 && (
              <dl class="kv">
                {costRowsWithData.map(([label, values]) => (
                  <>
                    <dt>{label}</dt>
                    <dd>{values.map((value) => <div>{value.text} <span class="muted small">{value.source}</span></div>)}</dd>
                  </>
                ))}
              </dl>
            )
          }
          {costs.fees.length > 0 && <p class="small muted">{m.cost_fees_note()}</p>}
          {missingCosts.length > 0 && <p class="small muted">{m.cost_missing({ items: missingCosts.join(', ') })}</p>}
        </div>
      </section>
    )
  }

  {
    (hasDocuments || switchables.length > 0) && (
      <section class="fund-section" id="documents">
        <h2 class="section-title">{m.documents_title()}</h2>
        <div class="card-grid">
          {
            hasDocuments && (
              <div class="card">
                <h3 class="card-title"><Fragment set:html={icon('file-text')} />{m.documents_card_title()}</h3>
                <ul class="doc-list">
                  {prospectus.slice(0, 1).map((document) => (
                    <li><a href={document.file}>{m.doc_prospectus()}</a> <span class="muted small">{m.documents_latest()}</span></li>
                  ))}
                  {factsheets.slice(0, 3).map((document) => (
                    <li><a href={document.file}>{m.doc_factsheet()}</a> <span class="muted small">{document.date ? formatMonth(document.date, locale) : document.name}</span></li>
                  ))}
                  {makmurDocuments.map(([label, url]) => (
                    <li><a href={url}>{label}</a> <span class="muted small">{m.documents_via_makmur()}</span></li>
                  ))}
                </ul>
                {(factsheets.length > 3 || prospectus.length > 1) && (
                  <details class="doc-more">
                    <summary>{olderDocumentCount === 1 ? m.documents_older_one() : m.documents_older({ count: olderDocumentCount })}</summary>
                    <ul class="doc-list">
                      {prospectus.slice(1).map((document) => (
                        <li><a href={document.file}>{m.doc_prospectus()}</a> <span class="muted small">{document.name}</span></li>
                      ))}
                      {factsheets.slice(3).map((document) => (
                        <li><a href={document.file}>{m.doc_factsheet()}</a> <span class="muted small">{document.date ? formatMonth(document.date, locale) : document.name}</span></li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            )
          }

          {
            switchables.length > 0 && (
              <div class="card">
                <h3 class="card-title"><Fragment set:html={icon('arrow-left-right')} />{m.switch_title()} <span class="aside muted">{m.switch_aside()}</span></h3>
                <ul class="doc-list">
                  {switchables.map((target) => (
                    <li><a href={href(`/funds/${fundIdOfBibitSymbol(target.symbol)}/`)}>{target.name}</a></li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>
    )
  }

  <section class="fund-section" id="data">
    <h2 class="section-title">{m.data_title()}</h2>
    <div class="card data-card">
      <h3 class="card-title"><Fragment set:html={icon('database')} />{m.nav_download()}</h3>
      <div class="downloads">
        <a class="btn" href={`/api/funds/${id}.json`} download><Fragment set:html={icon('download')} />JSON</a>
        {history.points.length > 0 && <a class="btn" href={`/csv/nav/${id}.csv`} download><Fragment set:html={icon('download')} />{m.data_nav_csv()}</a>}
        {hasAumChart && <a class="btn" href={`/csv/aum/${id}.csv`} download><Fragment set:html={icon('download')} />{m.data_aum_csv()}</a>}
      </div>
      <ul class="source-list small">
        {sources.map((source) => (
          <li><a href={source.url}>{source.name}</a> <span class="muted">{source.what} · <span class="mono">{source.ids.join(', ')}</span></span></li>
        ))}
      </ul>
      {
        history.used.length > 0 && (
          <p class="small muted">
            {m.data_chart_prefix()}{' '}
            {history.used.map((part, index) => (
              <>
                {index > 0 && m.data_chart_then()}
                {m.data_chart_part({ source: sourceLabel(part.source), date: formatDate(part.from, locale) })}
              </>
            ))}
            .{history.droppedSpikes > 0 && ` ${history.droppedSpikes === 1 ? m.data_spike_one() : m.data_spikes_many({ count: history.droppedSpikes })}`}
          </p>
        )
      }
    </div>
  </section>
  </div>

  <aside class="fund-aside">
    {
      buyLinks.length > 0 && (
        <section class="card buy-card" id="buy">
          <h2 class="card-title">{m.buy_title()}</h2>
          {buyLinks.map((link) => (
            <div class="buy-row">
              <a class="btn btn-primary" href={link.url} target="_blank" rel="sponsored noopener">{m.buy_open({ name: link.name })}<Fragment set:html={icon('arrow-up-right')} /></a>
              <span class="referral small muted">
                {m.buy_referral_code()} <code>{link.code}</code>
                <button class="copy" type="button" data-copy={link.code} data-copied={m.buy_copied()} data-failed={m.buy_copy_failed()} hidden><Fragment set:html={icon('copy', { size: 14 })} /><span class="copy-label">{m.buy_copy()}</span></button>
              </span>
            </div>
          ))}
          <p class="small muted">{m.buy_note()}</p>
        </section>
      )
    }

    <section class="card details-card">
      <h2 class="card-title">{m.details_title()}</h2>
      <dl class="kv">
        {details.map(([label, value, isMuted]) => (
          <>
            <dt>{label}</dt>
            <dd class={isMuted ? 'muted' : undefined}>{value}</dd>
          </>
        ))}
      </dl>
      {
        ojkSparkPath && (
          <figure class="ojk-spark">
            <svg viewBox="0 0 200 36" preserveAspectRatio="none" role="img" aria-label={m.ojk_spark_label({ from: formatMonth(`${ojk.months[0].month}-01`, locale), to: ojkMonth })}>
              <path d={ojkSparkPath} fill="none" stroke="var(--gold)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
            </svg>
            <figcaption class="muted small">{m.ojk_spark_label({ from: formatMonth(`${ojk.months[0].month}-01`, locale), to: ojkMonth })}</figcaption>
          </figure>
        )
      }
    </section>

  </aside>
  </div>
</Base>

<style is:global>
  /* Header band */

  .fund-hero {
    display: grid;
    gap: var(--s-4);
    border-radius: var(--r-lg);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .crumbs a {
    color: var(--ink-2);
  }

  .fund-hero-main {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .fund-hero::before {
    -webkit-mask-image: linear-gradient(100deg, transparent 55%, #000 100%);
    mask-image: linear-gradient(100deg, transparent 55%, #000 100%);
  }

  .fund-tile {
    width: 56px;
    height: 56px;
    border-radius: var(--r-md);
  }

  .fund-titles {
    min-width: 0;
  }

  .fund-titles .page-title {
    max-width: 32ch;
  }

  .fund-aka {
    margin-top: var(--s-1);
    max-width: 60ch;
  }

  .fund-manager {
    margin-top: var(--s-2);
    font-weight: var(--fw-label);
  }

  .fund-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .fund-chips .tag {
    min-height: 28px;
    padding: 0 var(--s-2);
    gap: var(--s-1);
    font-size: var(--fs-sm);
  }

  .fund-chips a.tag:hover {
    text-decoration: none;
    filter: brightness(0.96);
  }

  .chip-note {
    color: inherit;
    font-weight: var(--fw-body);
  }

  .chip-note::before {
    content: '· ';
  }

  .fund-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }

  .fund-buy-jump {
    display: none;
  }

  .action-status:empty {
    display: none;
  }

  .fund-notice {
    margin-top: var(--s-3);
  }

  /* Section navigation: sticky under the site header, one link per section that has data. */

  .section-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    margin: var(--s-4) calc(var(--gutter) * -1) 0;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .section-nav-list {
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .section-nav-list::-webkit-scrollbar {
    display: none;
  }

  .section-nav a {
    display: flex;
    align-items: center;
    height: 48px;
    padding: 0 var(--s-3);
    border-bottom: 2px solid transparent;
    color: var(--ink-2);
    font-weight: var(--fw-label);
    white-space: nowrap;
  }

  .section-nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .section-nav a[aria-current='location'] {
    border-bottom-color: var(--accent);
    color: var(--accent-strong);
  }

  .fund-section {
    margin-top: var(--s-6);
    scroll-margin-top: calc(var(--header-h) + 64px);
  }

  #overview {
    margin-top: 0;
    padding-top: var(--s-4);
  }

  .block-title {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin: var(--s-5) 0 var(--s-3);
  }

  .block-title .aside,
  .card-title .aside {
    margin-left: auto;
    font-size: var(--fs-sm);
    font-weight: var(--fw-body);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }

  .card-title > .icon {
    color: var(--muted);
  }

  /* Key figures */

  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    margin: 0;
  }

  /* Four across only where the column is wide enough, so the last card is never alone on a row. */
  @media (min-width: 880px) and (max-width: 999px), (min-width: 1280px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figure {
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }

  .figure dt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .figure dd {
    margin: 0;
  }

  .figure-value {
    margin-top: var(--s-2);
    font-size: var(--fs-xl);
    font-weight: var(--fw-strong);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .figure-value .unit {
    margin-left: var(--s-1);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-label);
    letter-spacing: 0;
  }

  .figure-sub {
    margin-top: var(--s-1);
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .info-btn {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: calc(var(--s-1) * -1) calc(var(--s-1) * -1) calc(var(--s-1) * -1) 0;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .info-btn:hover {
    background: var(--panel);
    color: var(--ink);
