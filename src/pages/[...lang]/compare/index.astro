---
import Base from '../../../layouts/Base.astro';
import { loadFundSummaries } from '../../../lib/data.js';
import { formatCount } from '../../../lib/format.js';
import { CHART_RANGES } from '../../../lib/compare.js';
import { localePaths } from '../../../lib/i18n.js';
import * as m from '../../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';
const dividendFundCount = loadFundSummaries().funds.filter((fund) => fund.total).length;
const RANGE_LABELS = { '1m': m.period_1m(), '6m': m.period_6m(), ytd: m.period_ytd(), '1y': m.period_1y(), '3y': m.period_3y(), '5y': m.period_5y(), all: m.period_all() };
---

<Base title={m.compare_title()} description={m.compare_description()} section="compare">
  <div class="intro">
    <h1 class="page-title">{m.compare_title()}</h1>
    <p class="lede">{m.compare_lede()}</p>
  </div>

  <div class="picker">
    <label class="search">
      <span class="visually-hidden">{m.compare_picker_label()}</span>
      <input id="picker-input" type="search" placeholder={m.search_placeholder()} autocomplete="off" spellcheck="false" />
    </label>
    <p class="muted small" id="picker-note" aria-live="polite"></p>
    <ul class="picker-results" id="picker-results" hidden></ul>
  </div>

  <label class="dividend-toggle">
    <input type="checkbox" id="include-dividends" /> {m.dividends_toggle()}
    <span class="muted small">{m.dividends_toggle_help({ count: formatCount(dividendFundCount, locale) })}</span>
  </label>

  <div id="compare-notices"></div>
  <p class="compare-empty" id="compare-empty">{m.compare_loading()}</p>

  <section class="section" id="compare-chart-section" hidden>
    <h2 class="section-title">{m.compare_chart_title()}</h2>
    <div class="chart-bar">
      <div class="seg" role="group" aria-label={m.chart_range_label()}>
        {CHART_RANGES.map((range) => <button type="button" data-range={range} aria-pressed="false">{RANGE_LABELS[range]}</button>)}
      </div>
      <span class="muted" id="chart-start"></span>
    </div>
    <ul class="compare-legend" id="compare-legend"></ul>
    <div class="chart" id="compare-chart"></div>
    <p class="chart-empty" id="chart-message" hidden></p>
    <p class="muted small">{m.compare_chart_caption()}</p>
  </section>

  <section class="section" id="compare-table-section" hidden>
    <h2 class="section-title">{m.compare_table_title()}</h2>
    <div class="table-scroll">
      <table class="tbl compare-table" id="compare-table"></table>
    </div>
    <p class="muted small table-note" id="table-end"></p>
  </section>
</Base>

<style is:global>
  .picker {
    display: grid;
    gap: 6px;
    max-width: 560px;
  }

  .picker .search input {
    width: 100%;
  }

  .picker-results {
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule-strong);
    list-style: none;
  }

  .picker-results li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 10px;
  }

  .picker-results li + li {
    border-top: 1px solid var(--rule);
  }

  .picker-results .sub {
    display: block;
    color: var(--muted);
    font-size: 12px;
  }

  .picker-results .mono {
    color: var(--faint);
    font-size: 11px;
  }

  #compare-notices {
    display: grid;
    gap: 6px;
    margin-top: 14px;
  }

  .compare-empty {
    margin-top: 18px;
    color: var(--ink-2);
  }

  .compare-empty .chosen {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 6px;
    padding: 0 4px 0 6px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
  }

  .remove {
    padding: 0 3px;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }

  .remove:hover {
    color: var(--ink);
  }

  .chart-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-bottom: 8px;
  }

  .compare-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0 0 6px;
    padding: 0;
    color: var(--ink-2);
    font-size: 12.5px;
    list-style: none;
  }

  .compare-legend .key-line,
  .compare-table .key-line,
  .chart-tip .key-line {
    width: 14px;
    height: 3px;
  }

  .chart-tip {
    min-width: 200px;
  }

  .chart-tip .tip-row b {
    max-width: 180px;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chart-tip .tip-note {
    margin: -2px 0 2px 20px;
  }

  .table-note {
    margin-top: 8px;
  }

  .compare-table {
    width: auto;
    min-width: 100%;
  }

  .compare-table th,
  .compare-table td {
    min-width: 160px;
    max-width: 240px;
  }

  /* Funds are columns, so every value lines up under its fund name. */
  .compare-table td.num {
    text-align: left;
  }

  .compare-table thead th {
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 500;
    white-space: normal;
  }

  .compare-table tbody th[scope='row'],
  .compare-table thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 120px;
    max-width: 150px;
    padding-right: 12px;
    background: var(--paper);
    white-space: normal;
  }

  .compare-table .col-head {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .compare-table .col-head .key-line {
    flex: none;
    transform: translateY(-3px);
  }

  .compare-table .col-head a {
    font-weight: 600;
  }

  .compare-table .col-head .remove {
    margin-left: auto;
  }

  .compare-table .sub {
    margin-top: 1px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
  }

  .compare-table .mono {
    font-size: 11.5px;
  }

  .compare-table .group th {
    position: static;
    padding-top: 14px;
    border-bottom: 1px solid var(--rule-strong);
    background: none;
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 650;
    text-align: left;
  }

  .compare-table .tag {
    font-size: 11px;
    line-height: 15px;
  }

  @media (max-width: 720px) {
    .compare-table th,
    .compare-table td {
      min-width: 140px;
    }
  }
</style>

<script>
  import { mountComparePage } from '../../../lib/compare-page.js';

  mountComparePage();
</script>
