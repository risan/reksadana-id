---
import Base from '../../../layouts/Base.astro';
import { loadFundSummaries } from '../../../lib/data.js';
import { formatCount } from '../../../lib/format.js';
import { CHART_RANGES } from '../../../lib/compare.js';
import { localePaths } from '../../../lib/i18n.js';
import { icon } from '../../../lib/icons.js';
import * as m from '../../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';
const dividendFundCount = loadFundSummaries().funds.filter((fund) => fund.total).length;
const RANGE_LABELS = { '1m': m.period_1m(), '6m': m.period_6m(), ytd: m.period_ytd(), '1y': m.period_1y(), '3y': m.period_3y(), '5y': m.period_5y(), all: m.period_all() };
---

<Base title={m.compare_title()} description={m.compare_description()} section="compare">
  <div class="intro">
    <h1 class="page-title">{m.compare_title()}</h1>
    <p class="lede">{m.compare_lede()}</p>
  </div>

  <section class="card picker" id="picker">
    <div class="picker-field">
      <label class="search">
        <span class="visually-hidden">{m.compare_picker_label()}</span>
        <Fragment set:html={icon('search')} />
        <input id="picker-input" type="search" role="combobox" aria-expanded="false" aria-controls="picker-results" aria-autocomplete="list" placeholder={m.search_placeholder()} autocomplete="off" spellcheck="false" />
      </label>
      <ul class="picker-results" id="picker-results" aria-label={m.compare_results_label()} hidden></ul>
    </div>
    <p class="muted small" id="picker-note" aria-live="polite"></p>
    <ul class="selected-chips" id="selected-chips" aria-label={m.compare_selected_label()}></ul>
    <label class="dividend-toggle">
      <input type="checkbox" id="include-dividends" /> {m.dividends_toggle()}
      <span class="muted small">{m.dividends_toggle_help({ count: formatCount(dividendFundCount, locale) })}</span>
    </label>
  </section>

  <div id="compare-notices"></div>
  <div class="empty-state kawung-bg" id="compare-empty">{m.compare_loading()}</div>

  <section class="section" id="compare-chart-section" hidden>
    <h2 class="section-title">{m.compare_chart_title()}</h2>
    <div class="card chart-card">
      <div class="chart-bar">
        <div class="seg" role="group" aria-label={m.chart_range_label()}>
          {CHART_RANGES.map((range) => <button type="button" data-range={range} aria-pressed="false">{RANGE_LABELS[range]}</button>)}
        </div>
        <span class="muted small" id="chart-start"></span>
      </div>
      <div class="chart" id="compare-chart"></div>
      <p class="chart-empty" id="chart-message" hidden></p>
      <p class="muted small">
        <span data-view="nav">{m.compare_chart_caption()}</span>
        <span data-view="total">{m.compare_chart_caption_total()}</span>
      </p>
    </div>
  </section>

  <section class="section" id="compare-table-section" hidden>
    <h2 class="section-title">{m.compare_table_title()}</h2>
    <div class="table-scroll">
      <table class="tbl compare-table" id="compare-table"></table>
    </div>
    <p class="muted small table-note"><span class="best-dot" aria-hidden="true"></span> {m.compare_best_note()}</p>
    <p class="muted small table-note" id="table-end"></p>
  </section>
</Base>

<style is:global>
  .picker {
    display: grid;
    gap: var(--s-3);
  }

  .picker-field {
    position: relative;
    max-width: 640px;
  }

  .picker-results {
    position: absolute;
    top: calc(100% + var(--s-1));
    right: 0;
    left: 0;
    z-index: 30;
    max-height: min(60vh, 440px);
    margin: 0;
    padding: var(--s-1);
    overflow-y: auto;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    list-style: none;
  }

  .picker-results .nil {
    padding: var(--s-3);
  }

  .pick {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    min-height: 52px;
    padding: var(--s-2) var(--s-3);
    border: 0;
    border-radius: var(--r-sm);
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pick:hover:not(:disabled),
  .pick:focus-visible {
    background: var(--panel);
  }

  .pick:disabled {
    color: var(--muted);
    cursor: default;
  }

  .pick-text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .pick-name {
    overflow: hidden;
    font-weight: var(--fw-label);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick-sub {
    overflow: hidden;
    color: var(--muted);
    font-size: var(--fs-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick-state {
    color: var(--accent);
    font-size: var(--fs-sm);
    font-weight: var(--fw-label);
  }

  .pick:disabled .pick-state {
    color: var(--muted);
  }

  .selected-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .selected-chips:empty {
    display: none;
  }

  .selected-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    max-width: 100%;
    min-height: 40px;
    padding: 0 var(--s-1) 0 var(--s-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: var(--fs-sm);
    font-weight: var(--fw-label);
  }

  .selected-chip .chip-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
  }

  .selected-chip a {
    overflow: hidden;
    color: var(--ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .remove {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .remove:hover {
    background: var(--panel);
    color: var(--ink);
  }

  #compare-notices {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }

  .empty-state {
    margin-top: var(--s-4);
    color: var(--ink-2);
  }

  .chart-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-bottom: var(--s-3);
  }

  .chart-card .chart {
    margin-bottom: var(--s-2);
  }

  .chart-tip {
    min-width: 200px;
  }

  .chart-tip .key-line {
    width: 14px;
    height: 3px;
  }

  .chart-tip .tip-note {
    margin: -2px 0 var(--s-1) 20px;
  }

  .table-note {
    margin-top: var(--s-2);
  }

  .best-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background: var(--gold);
  }

  /* In the cell's left gutter, so the value keeps its place whether the cell has one line or several. */
  .compare-table td {
    position: relative;
  }

  .compare-table td .best-dot {
    position: absolute;
    top: calc(var(--s-2) + 0.5em);
    left: calc(var(--s-1) / 2);
  }

  .compare-table {
    width: auto;
    min-width: 100%;
  }

  .compare-table th,
  .compare-table td {
    min-width: 168px;
    max-width: 240px;
  }

  /* Funds are columns, so every value lines up under its fund name. */
  .compare-table td.num {
    text-align: left;
  }

  .compare-table thead th {
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-label);
    white-space: normal;
  }

  .compare-table thead th.c-fund {
    border-top: 3px solid var(--column-color, transparent);
  }

  .compare-table tbody th[scope='row'],
  .compare-table thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 112px;
    max-width: 150px;
    padding-right: var(--s-3);
    box-shadow: 1px 0 0 var(--rule);
    white-space: normal;
  }

  .compare-table tbody th[scope='row'] {
    background: var(--surface);
  }

  .compare-table .col-head {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .compare-table .col-head .icon-tile {
    width: 28px;
    height: 28px;
    border-radius: var(--r-xs);
  }

  .compare-table .col-head a {
    flex: 1;
    min-width: 0;
    font-weight: var(--fw-strong);
  }

  .compare-table .col-head .remove {
    width: 28px;
    height: 28px;
    margin: 0 calc(var(--s-1) * -1) 0 0;
  }

  .compare-table .sub {
    margin-top: 1px;
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-body);
  }

  .compare-table .mono {
    font-size: var(--fs-xs);
  }

  .compare-table .group th {
    position: static;
    padding-top: var(--s-4);
    border-bottom: 1px solid var(--rule-strong);
    background: none;
    box-shadow: none;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-strong);
    text-align: left;
  }

  .compare-table .tag {
    font-size: var(--fs-xs);
    line-height: 20px;
  }

  @media (max-width: 719px) {
    .compare-table th,
    .compare-table td {
      min-width: 148px;
    }

    .compare-table tbody th[scope='row'],
    .compare-table thead th:first-child {
      min-width: 96px;
      max-width: 104px;
      padding-right: var(--s-2);
    }

    .compare-table .col-head .remove {
      width: 44px;
      height: 44px;
      margin: calc(var(--s-3) * -1) calc(var(--s-3) * -1) 0 0;
    }

    .remove {
      width: 44px;
      height: 44px;
    }

    .selected-chip {
      min-height: 44px;
    }
  }
</style>

<script>
  import { mountComparePage } from '../../../lib/compare-page.js';

  mountComparePage();
</script>
