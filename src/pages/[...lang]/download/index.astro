---
import Base from '../../../layouts/Base.astro';
import { listArchives, zipArchive } from '../../../lib/archives.js';
import { FUND_TYPES } from '../../../lib/fund-types.js';
import { formatNumber } from '../../../lib/format.js';
import { anchor, localePaths, localizeHref } from '../../../lib/i18n.js';
import { icon } from '../../../lib/icons.js';
import * as m from '../../../paraglide/messages.js';

export const getStaticPaths = () => localePaths();

const locale = Astro.currentLocale ?? 'id';

const archives = listArchives().map((archive) => ({ ...archive, bytes: zipArchive(archive).length }));

const formatSize = (bytes) => (bytes < 1e6 ? `${formatNumber(bytes / 1e3, locale, 0)} KB` : `${formatNumber(bytes / 1e6, locale, 1, 1)} MB`);

const navArchiveCount = archives.filter((archive) => archive.name.startsWith('bareksa-nav-')).length;

function archiveDescription(archive) {
  if (archive.name === 'bareksa') {
    return m.download_zip_bareksa();
  }

  if (archive.name.startsWith('bareksa-nav-')) {
    return m.download_zip_bareksa_nav({ part: archive.name.replace('bareksa-nav-', ''), total: navArchiveCount });
  }

  return m.download_zip_everything({ folder: `data/${archive.name}/` });
}

const SOURCES = [
  {
    name: 'Bibit',
    url: 'https://app.bibit.id/',
    site: 'app.bibit.id',
    rhythm: m.download_rhythm_daily(),
    files: [
      ['data/bibit/funds.csv', m.download_bibit_funds()],
      ['data/bibit/funds/<symbol>.json', m.download_bibit_fund_json()],
      ['data/bibit/nav/<symbol>.csv', m.download_bibit_nav()],
      ['data/bibit/aum/<symbol>.csv', m.download_bibit_aum()],
      ['data/bibit/dividends/<symbol>.json', m.download_bibit_dividends()],
      ['data/bibit/documents/<symbol>.json', m.download_bibit_documents()],
      ['data/bibit/switchables/<symbol>.json', m.download_bibit_switchables()],
      ['data/bibit/types.json', m.download_bibit_types()],
    ],
  },
  {
    name: 'Kontan',
    url: 'https://pusatdata.kontan.co.id/reksadana',
    site: 'pusatdata.kontan.co.id',
    rhythm: m.download_rhythm_weekly(),
    files: [
      ['data/kontan/funds.csv', m.download_kontan_funds()],
      ['data/kontan/nav/<kontan_id>.csv', m.download_kontan_nav()],
    ],
  },
  {
    name: 'Bareksa',
    url: 'https://www.bareksa.com/id/data/reksadana/daftar',
    site: 'bareksa.com',
    rhythm: m.download_rhythm_bareksa(),
    files: [
      ['data/bareksa/funds.csv', m.download_bareksa_funds()],
      ['data/bareksa/prospectus.csv', m.download_bareksa_prospectus()],
      ['data/bareksa/aum/<bareksa_id>.csv', m.download_bareksa_aum()],
      ['data/bareksa/units/<bareksa_id>.csv', m.download_bareksa_units()],
      ['data/bareksa/allocation/<bareksa_id>.csv', m.download_bareksa_allocation()],
      ['data/bareksa/nav/<bareksa_id>.csv', m.download_bareksa_nav()],
    ],
  },
  {
    name: m.download_source_managers(),
    url: null,
    site: m.download_site_managers(),
    rhythm: m.download_rhythm_weekly(),
    files: [['data/managers/prospectus.csv', m.download_managers_prospectus()]],
  },
  {
    name: 'Makmur',
    url: 'https://www.makmur.id/',
    site: 'makmur.id',
    rhythm: m.download_rhythm_weekly(),
    files: [
      ['data/makmur/funds.csv', m.download_makmur_funds()],
      ['data/makmur/funds/<makmur_id>.json', m.download_makmur_fund_json()],
    ],
  },
  {
    name: m.api_group_benchmarks(),
    url: 'https://www.bareksa.com/',
    site: 'bareksa.com',
    rhythm: m.download_rhythm_daily(),
    files: [
      ['data/benchmarks/benchmarks.json', m.download_benchmarks_list()],
      ['data/benchmarks/<id>.csv', m.download_benchmarks_csv()],
    ],
  },
  {
    name: 'Bank Indonesia',
    url: 'https://www.bi.go.id/',
    site: 'bi.go.id',
    rhythm: m.download_rhythm_daily(),
    files: [
      ['data/macro/usd-idr.csv', m.download_macro_usdidr()],
      ['data/macro/bi-rate.csv', m.download_macro_birate()],
      ['data/macro/inflation.csv', m.download_macro_inflation()],
    ],
  },
  {
    name: 'OJK',
    url: 'https://reksadana.ojk.go.id/',
    site: 'reksadana.ojk.go.id',
    rhythm: m.download_rhythm_ojk(),
    files: [['data/ojk/monthly/<YYYY-MM>.csv', m.download_ojk_monthly()]],
  },
];
---

<Base title={m.download_title()} description={m.download_description()} section="download">
  <h1 class="page-title">{m.download_title()}</h1>
  <p class="lede">{m.download_lede()}</p>

  <section class="section">
    <div class="card featured">
      <span class="icon-tile" set:html={icon('table-2', { size: 20 })} />
      <div class="featured-text">
        <h2 class="card-title"><code>funds.csv</code></h2>
        <p class="muted small" set:html={m.download_funds_csv_note({ apiLink: anchor(localizeHref('/api/', locale), m.nav_api()) })} />
      </div>
      <a class="btn btn-primary" href="/csv/funds.csv" download><Fragment set:html={icon('download')} />{m.download_funds_csv()}</a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{m.download_zip_title()}</h2>
    <p class="prose" set:html={m.download_zip_text()} />
    <ul class="archive-grid">
      {
        archives.map((archive) => (
          <li class="card archive">
            <div class="archive-head">
              <span class="icon-tile" set:html={icon('layers', { size: 20 })} />
              <h3 class="card-title"><code>{archive.name}.zip</code></h3>
            </div>
            <p class="muted small">{archiveDescription(archive)}</p>
            <div class="archive-foot">
              <span class="muted small">{formatSize(archive.bytes)}</span>
              <a class="btn btn-sm" href={`/download/${archive.name}.zip`} download><Fragment set:html={icon('download', { size: 16 })} />{m.download_button()}</a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">{m.download_contents_title()}</h2>
    <div class="source-list">
      {
        SOURCES.map((source) => (
          <div class="table-scroll">
            <div class="source-head">
              <h3 class="card-title">{source.name}</h3>
              <span class="muted small">{source.url ? <a href={source.url}>{source.site}</a> : source.site} · {source.rhythm}</span>
            </div>
            <table class="tbl files-table">
              <tbody>
                {source.files.map(([file, description]) => (
                  <tr>
                    <td><code>{file}</code></td>
                    <td>{description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{m.download_notes_title()}</h2>
    <div class="card notes">
      <span class="icon-tile" set:html={icon('info', { size: 20 })} />
      <ul class="prose">
        <li set:html={m.download_note_history()} />
        <li set:html={m.download_note_units()} />
        <li set:html={m.download_note_makmur()} />
      </ul>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">{m.download_types_title()}</h2>
    <div class="table-scroll types-table">
      <table class="tbl">
        <thead>
          <tr>
            <th>{m.download_types_type()}</th>
            <th>{m.download_types_english()}</th>
          </tr>
        </thead>
        <tbody>
          {
            FUND_TYPES.map((type) => (
              <tr>
                <td><code>{type.label}</code></td>
                <td>{type.english}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .featured {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .featured-text {
    flex: 1;
    min-width: 0;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-4);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .archive {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .archive-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .archive-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .source-list {
    display: grid;
    gap: var(--s-4);
  }

  .source-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    padding: var(--s-4);
    border-bottom: 1px solid var(--rule-strong);
    background: var(--panel);
  }

  .files-table td:first-child {
    width: 1%;
    white-space: nowrap;
  }

  .notes {
    display: flex;
    gap: var(--s-4);
  }

  .notes ul {
    margin: 0;
    padding-left: var(--s-5);
  }

  .types-table {
    max-width: 480px;
  }

  @media (max-width: 719px) {
    .featured {
      flex-direction: column;
      align-items: stretch;
    }

    .files-table,
    .files-table tbody,
    .files-table tr,
    .files-table td {
      display: block;
    }

    .files-table tr {
      padding: var(--s-2) 0;
      border-bottom: 1px solid var(--rule);
    }

    .files-table tr:last-child {
      border-bottom: 0;
    }

    .files-table td {
      width: auto;
      padding-top: var(--s-1);
      padding-bottom: var(--s-1);
      border-bottom: 0;
    }

    .files-table td:first-child {
      width: auto;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .notes .icon-tile {
      display: none;
    }
  }
</style>
